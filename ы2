local function applyOthersBodyPart(
    property,
    assetId
)

    local description

    local humanoid =
        getOthersHumanoid()

    if not humanoid then
        return false
    end

    if not rememberOthersOriginal(
        humanoid
    ) then
        return false
    end

    local success

    success =
        pcall(function()

            description =
                humanoid:GetAppliedDescription()

        end)

    if not success
        or not description
    then

        return false

    end

    local setSuccess =
        pcall(function()

            description[property] =
                assetId

        end)

    if not setSuccess then
        return false
    end

    return applyOthersDescription(
        description
    )

end

local function applyOthersField(
    slot,
    textValue
)

    local description =
        getOthersCurrentDescription()

    if not description then
        return false
    end

    local value

    if slot.multi then

        value =
            normalizeOthersAccessoryText(
                textValue
            )

    else

        value =
            tonumber(
                normalizeOthersNumberText(
                    textValue
                )
            )
            or 0

    end

    local success, err =
        pcall(function()

            description[
                slot.property
            ] =
                value

        end)

    if not success then

        warn(
            "[Others] Failed to set",
            slot.property,
            err
        )

        if othersStatus then
            othersStatus.Text =
                "Не удалось изменить " ..
                slot.label
        end

        return false

    end

    return applyOthersDescription(
        description
    )

end

local function scanOthers()

    local description =
        getOthersCurrentDescription()

    if not description then
        return false
    end

    local allSlots = {}

    for _, slot in ipairs(
        OTHERS_ACCESSORY_SLOTS
    ) do

        table.insert(
            allSlots,
            slot
        )

    end

    for _, slot in ipairs(
        OTHERS_CLOTHING_SLOTS
    ) do

        table.insert(
            allSlots,
            slot
        )

    end

    for _, slot in ipairs(
        OTHERS_BODY_SLOTS
    ) do

        table.insert(
            allSlots,
            slot
        )

    end

    for _, slot in ipairs(
        allSlots
    ) do

        local box =
            othersFieldBoxes[
                slot.property
            ]

        if box then

            box.Text =
                getOthersPropertyText(
                    description,
                    slot
                )

        end

    end

    if othersStatus then

        othersStatus.Text =
            "Сканировано • R6"

    end

    return true

end

local function clearOthersAccessories()

    local description =
        getOthersCurrentDescription()

    if not description then
        return false
    end

    for _, property in ipairs(
        OTHERS_CLEAR_ACCESSORY_PROPERTIES
    ) do

        pcall(function()

            description[property] =
                ""

        end)

    end

    --// Face is not 2D clothing and is therefore removed.
    pcall(function()
        description.Face = 0
    end)

    return applyOthersDescription(
        description
    )

end

local function restoreOthers(
    keepSnapshot
)

    if not othersOriginalDescription then
        return false
    end

    local description =
        othersOriginalDescription

    local applied =
        applyOthersDescription(
            description
        )

    if not keepSnapshot then

        othersTargetHumanoid =
            nil

        othersOriginalDescription =
            nil

    end

    return applied

end

