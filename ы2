--// DeadEye loader
--// The source is split into 3 parts to stay below repository/tool size limits.
local BASE = "https://raw.githubusercontent.com/skirkzhdimenya-source/DeadEye/main/"

local source =
    game:HttpGet(BASE .. "deadeeye_part1.lua")
    .. game:HttpGet(BASE .. "deadeeye_part2.lua")
    .. game:HttpGet(BASE .. "deadeeye_part3.lua")

local fn = loadstring(source)
if not fn then
    error("[DeadEye] Failed to load source")
end

return fn()