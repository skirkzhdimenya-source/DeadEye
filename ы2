local function cleanup()

    if cleaned then
        return
    end

    cleaned = true

    genv.EMOTE_SWAPPER_RUNNING =
        false

    enabled = false

    replacementGeneration =
        replacementGeneration + 1

    replacementRunning =
        false

    if currentCustomEmote then

        stopEmoteObject(
            currentCustomEmote
        )

        currentCustomEmote =
            nil

    end

    pcall(function()
        Picker.Visible = false
    end)

    disconnectAll()

    pcall(function()
        ScreenGui:Destroy()
    end)

    genv.EMOTE_SWAPPER_CLEANUP =
        nil

    print(
        "[EmoteSwapper] Полностью завершён"
    )

end

