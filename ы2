local function beginWindowDrag(input)
    if input.UserInputType ==
            Enum.UserInputType.MouseButton1
        or input.UserInputType ==
            Enum.UserInputType.Touch
    then
        dragging = true
        dragStart =
            input.Position
        startPosition =
            Main.Position
    end
end

