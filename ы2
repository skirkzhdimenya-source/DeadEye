--// =========================================================
--// BUILD UNUSUAL LIST
--// Full client pool = EquipInfo.SlotType == "Unusual"
--// =========================================================

local function buildUnusualList()

    table.clear(unusualList)

    local all

    local success, result = pcall(function()
        return Registry.GetAll()
    end)

    if not success or not result then

        warn(
            "[UnusualSwapper] Registry.GetAll error:",
            result
        )

        return
    end

    all = result

    local seen = {}

    for id, data in pairs(all) do

        local numericId = tonumber(id)

        if numericId
            and not seen[numericId]
        then

            local config

            pcall(function()
                config =
                    Registry.GetConfig(
                        numericId
                    )
            end)

            local equipInfo =
                type(config) == "table"
                and config.EquipInfo
                or nil

            if type(equipInfo) == "table"
                and equipInfo.SlotType == "Unusual"
            then

                local module =
                    data
                    and data.Module

                if not module then

                    pcall(function()

                        local entry =
                            Registry.GetById(
                                numericId
                            )

                        if entry then
                            module =
                                entry.Module
                        end

                    end)

                end

                if module then

                    seen[numericId] = true

                    table.insert(
                        unusualList,
                        {
                            id = numericId,
                            name = module.Name,
                            module = module
                        }
                    )

                end

            end

        end

    end

    table.sort(
        unusualList,
        function(a, b)
            return a.id < b.id
        end
    )

    print(
        "[UnusualSwapper] Unusuals:",
        #unusualList
    )

end

buildUnusualList()

