        end)
    end
    pcall(function()
        description.Face = 0
    end)
    return others.applyDescription(
        description
    )
end
function others.restore(
    keepSnapshot
)
    if not others.originalDescription then
        return false
    end
    local result =
        others.applyDescription(
            others.originalDescription
        )
    if not keepSnapshot then
        others.originalDescription =
            nil
        others.targetHumanoid =
            nil
    end
    return result
end
