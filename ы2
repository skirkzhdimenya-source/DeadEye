local function getUnusualName(id)

    id = tonumber(id)

    if not id then
        return nil
    end

    for _, data in ipairs(unusualList) do

        if data.id == id then
            return data.name
        end

    end

    local module =
        getItemModule(id)

    if module then
        return module.Name
    end

    return nil

end

