            .. " • Original"
    else
        PickerTitle.Text =
            "Slot "
            .. tostring(
                slotIndex
            )
            .. " • Replace"
    end
    PickerSearch.Text =
        ""
    rebuildPicker()
    Picker.Visible =
        true
end
