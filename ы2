local function cleanup()
    if cleaned then
        return
    end
    pcall(function()
        if genv.UNUSUAL_SWAPPER_CLEANUP then
            genv.UNUSUAL_SWAPPER_CLEANUP()
        end
    end)
    pcall(function()
        if genv.DEADEYE_PORTRAIT_CLEANUP then
            genv.DEADEYE_PORTRAIT_CLEANUP()
        end
    end)
    cleaned = true
    genv.EMOTE_SWAPPER_RUNNING =
        false
    enabled = false
    replacementGeneration =
        replacementGeneration + 1
    replacementRunning =
        false
    if currentCustomEmote then
        stopEmoteObject(
            currentCustomEmote
        )
        currentCustomEmote =
            nil
    end
    pcall(function()
        Picker.Visible = false
    end)
    disconnectAll()
    pcall(function()
        ScreenGui:Destroy()
    end)
    genv.EMOTE_SWAPPER_CLEANUP =
        nil
end
genv.EMOTE_SWAPPER_CLEANUP =
    cleanup
