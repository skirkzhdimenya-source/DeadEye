                if rig then

                    local expected =
                        rig:FindFirstChild(
                            "DeadEyeUnusual_" ..
                            tostring(
                                unusualSlot.replaceId
                            )
                        )

                    if not expected then
                        reapplyUnusual()
                    end

                end

            end

        end
    )
)
