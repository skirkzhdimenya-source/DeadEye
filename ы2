--// =========================================================
--// APPLY UNUSUAL FX ONLY
-- =========================================================
local function applyUnusualFX(
    id,
    visualRig,
    playerCharacter
)
    local cosmeticRig =
        getUnusualCosmeticRig(
            id,
            visualRig
        )

    if not cosmeticRig then
        return false
    end

    local targetRoot =
        visualRig:FindFirstChild(
            "HumanoidRootPart"
        )

    if not targetRoot
        and playerCharacter
    then
        targetRoot =
            playerCharacter:FindFirstChild(
                "HumanoidRootPart"
            )
    end

    if not targetRoot then
        return false
    end

    local clone

    if not pcall(function()
        clone =
            cosmeticRig:Clone()
    end) or not clone
    then
        return false
    end

    local cloneRoot =
        clone:FindFirstChild(
            "HumanoidRootPart"
        )

    if not cloneRoot
        or not cloneRoot:IsA("BasePart")
    then
        clone:Destroy()
        return false
    end

    clone.Name =
        "DeadEyeUnusual_" ..
        tostring(id)

    --// Remove executable code, but keep the complete
    --// visual/animation structure of the cosmetic rig.
    for _, object in ipairs(
        clone:GetDescendants()
    ) do

        if object:IsA("Script")
            or object:IsA("LocalScript")
            or object:IsA("ModuleScript")
        then

            pcall(function()
                object:Destroy()
            end)

        elseif object:IsA("BasePart") then

            object.CanCollide =
                false

            object.CanTouch =
                false

            object.CanQuery =
                false

            object.Massless =
                true

        end

    end

    --// Hide only the cosmetic rig's own body meshes.
    --// Their children (ears, whiskers, particles, trails,
    --// accessories, attachments, etc.) remain visible.
    local bodyNames = {
        Head = true,
        Torso = true,
        ["Left Arm"] = true,
        ["Right Arm"] = true,
        ["Left Leg"] = true,
        ["Right Leg"] = true,
        HumanoidRootPart = true
    }

    for _, object in ipairs(
        clone:GetChildren()
    ) do

        if object:IsA("BasePart")
            and bodyNames[object.Name]
        then

            object.Transparency =
                1

            object.CastShadow =
                false

            pcall(function()
                object.LocalTransparencyModifier =
                    1
            end)

            --// Do not render a face/decal belonging to
            --// the hidden cosmetic head itself.
            for _, child in ipairs(
                object:GetChildren()
            ) do

                if child:IsA("Decal")
                    or child:IsA("Texture")
                then

                    pcall(function()
                        child.Transparency =
                            1
                    end)

                end

            end

        end

    end

    local sourcePivot =
        cosmeticRig:GetPivot()

    local pivotOffset =
        cosmeticRig:FindFirstChild(
            "HumanoidRootPart"
        ).CFrame:ToObjectSpace(
            sourcePivot
        )

    clone.Parent =
        visualRig

    pcall(function()
        clone:PivotTo(
            targetRoot.CFrame *
            pivotOffset
        )
    end)

    local weld =
        Instance.new(
            "WeldConstraint"
        )

    weld.Name =
        "DeadEyeUnusualRootWeld"

    weld.Part0 =
        targetRoot

    weld.Part1 =
        cloneRoot

    weld.Parent =
        clone

    tagUnusualFX(
        clone,
        id
    )

    return true
end

