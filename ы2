    local saved =
        savedConfig.others

    if type(saved) ~= "table" then
        return
    end

    for _, group in ipairs({
        others.ACCESSORY_SLOTS,
        others.CLOTHING_SLOTS,
        others.BODY_SLOTS
    }) do

        for _, slot in ipairs(
            group
        ) do

            local box =
                others.fieldBoxes[
                    slot.property
