--// =========================================================
--// NORMALIZE ANIMATION ID
--// =========================================================

local function normalizeAnimationId(id)

    if not id then
        return nil
    end

    local text = tostring(id)

    local number = string.match(
        text,
        "%d+"
    )

    return number or text
end

--// =========================================================
