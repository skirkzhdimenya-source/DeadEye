    if mainJump.character
        and hit:IsDescendantOf(
            mainJump.character
        )
    then
        return
    end
    task.wait(
        mainJump.jumpDelay
    )
    if not genv.DEADEYE_MAIN_RUNNING
        or not mainJump.enabled
    then
        return
    end
    mainJump.jump(hit)
