--// HAS UNUSUAL CONTENT
--// =========================================================

local function unusualBasePartHasContent(
    sourcePart
)

    for _, object in ipairs(
        sourcePart:GetDescendants()
    ) do

        if unusualObjectBelongsToPart(
            object,
            sourcePart
        ) then

            if isUnusualFX(object) then
                return true
            end

            if object:IsA("Attachment")
                and unusualAttachmentHasFX(
                    object
                )
            then
                return true
            end

        end

    end

    return false

end

