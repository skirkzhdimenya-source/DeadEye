local function getOthersHumanoids()

    local result = {}
    local seen = {}

    local function addHumanoid(
        humanoid
    )

        if humanoid
            and humanoid:IsA("Humanoid")
            and not seen[humanoid]
        then

            seen[humanoid] =
                true

            table.insert(
                result,
                humanoid
            )

        end

    end

    local visualRig =
        getUnusualVisualRig()

    if visualRig then

        addHumanoid(
            visualRig:FindFirstChildOfClass(
                "Humanoid"
            )
        )

    end

    local character =
        getUnusualPlayerCharacter()

    if character then

        addHumanoid(
            character:FindFirstChildOfClass(
                "Humanoid"
            )
        )

    end

    return result

end

local function getOthersHumanoid()

    local humanoids =
        getOthersHumanoids()

    return humanoids[1]

end

local function rememberOthersOriginal(
    humanoid
)

    if othersOriginalDescription then

        return true

    end

    humanoid =
        humanoid
        or getOthersHumanoid()

    if not humanoid then
        return false
    end

    local success, description =
        pcall(function()
            return humanoid:GetAppliedDescription()
        end)

    if not success
        or not description
    then

        warn(
            "[Others] GetAppliedDescription error:",
            description
        )

        return false

    end

    local cloneSuccess, clone =
        pcall(function()
            return description:Clone()
        end)

    if not cloneSuccess
        or not clone
    then

        warn(
            "[Others] Failed to clone initial HumanoidDescription"
        )

        return false

    end

    othersTargetHumanoid =
        humanoid

    othersOriginalDescription =
        clone

    return true

end

local function normalizeOthersAccessoryText(
    value
)

    value =
        tostring(value or "")

    value =
        string.gsub(
            value,
            "%s+",
            ""
        )

    value =
        string.gsub(
            value,
            "[^%d,]",
            ""
        )

    value =
        string.gsub(
            value,
            ",+",
            ","
        )

    value =
        string.gsub(
            value,
            "^,",
            ""
        )

    value =
        string.gsub(
            value,
            ",$",
            ""
        )

    return value

end

local function normalizeOthersNumberText(
    value
)

    local number =
        string.match(
            tostring(value or ""),
            "%d+"
        )

    return number or ""

end

local function getOthersCurrentDescription()

    local humanoid =
        getOthersHumanoid()

    if not humanoid then
        return nil
    end

    if humanoid.RigType
        ~= Enum.HumanoidRigType.R6
    then

        if othersStatus then
            othersStatus.Text =
                "Только R6"
        end

        return nil

    end

    if not rememberOthersOriginal(
        humanoid
    ) then
        return nil
    end

    local success, description =
        pcall(function()
            return humanoid:GetAppliedDescription()
        end)

    if not success
        or not description
    then

        if othersStatus then
            othersStatus.Text =
                "Не удалось получить AvatarDescription"
        end

        return nil

    end

    return description

end

local function getOthersPropertyText(
    description,
    slot
)

    local success, value =
        pcall(function()
            return description[
                slot.property
            ]
        end)

    if not success
        or value == nil
    then
        return ""
    end

    if slot.multi then
        return tostring(value)
    end

    local number =
        tonumber(value)

    if not number
        or number == 0
    then
        return ""
    end

    return tostring(number)

end

local function refreshOthersFields()

    local description

    local humanoid =
        getOthersHumanoid()

    if not humanoid then
        return
    end

    local success =
        pcall(function()

            description =
                humanoid:GetAppliedDescription()

        end)

    if not success
        or not description
    then
        return
    end

    local allSlots = {}

    for _, slot in ipairs(
        OTHERS_ACCESSORY_SLOTS
    ) do
        table.insert(
            allSlots,
            slot
        )
    end

    for _, slot in ipairs(
        OTHERS_CLOTHING_SLOTS
    ) do
        table.insert(
            allSlots,
            slot
        )
    end

    for _, slot in ipairs(
        OTHERS_BODY_SLOTS
    ) do
        table.insert(
            allSlots,
            slot
        )
    end

    for _, slot in ipairs(
        allSlots
    ) do

        local box =
            othersFieldBoxes[
                slot.property
            ]

        if box then

            box.Text =
                getOthersPropertyText(
                    description,
                    slot
                )

        end

    end

end

local function applyOthersDescription(
    description
)

    local humanoids =
        getOthersHumanoids()

    if #humanoids == 0 then

        if othersStatus then
            othersStatus.Text =
                "Humanoid не найден"
        end

        return false

    end

    local appliedCount = 0
    local lastError

    for _, humanoid in ipairs(
        humanoids
    ) do

        if humanoid.RigType
            == Enum.HumanoidRigType.R6
        then

            --// Reset is important here:
            --// it forces the whole visual state to match
            --// the supplied description.
            local ok, err =
                pcall(function()

                    humanoid:ApplyDescriptionResetAsync(
                        description
                    )

                end)

            if not ok then

                lastError =
                    err

                local legacyOk, legacyErr =
                    pcall(function()

                        humanoid:ApplyDescriptionReset(
                            description
                        )

                    end)

                if legacyOk then

                    ok =
                        true

                else

                    lastError =
                        legacyErr

                    local asyncOk, asyncErr =
                        pcall(function()

                            humanoid:ApplyDescriptionAsync(
                                description
                            )

                        end)

                    if asyncOk then

                        ok =
                            true

                    else

                        lastError =
                            asyncErr

                        local oldOk, oldErr =
                            pcall(function()

                                humanoid:ApplyDescription(
                                    description
                                )

                            end)

                        if oldOk then

                            ok =
                                true

                        else

                            lastError =
                                oldErr

                        end

                    end

                end

            end

            if ok then

                appliedCount += 1

            end

        end

    end

    if appliedCount == 0 then

        warn(
            "[Others] ApplyDescription error:",
            lastError
        )

        if othersStatus then
            othersStatus.Text =
                "Ошибка Apply"
        end

        return false

    end

    if othersStatus then
        othersStatus.Text =
            "Применено"
    end

    task.delay(
        0.25,
        function()

            pcall(function()
                refreshOthersFields()
            end)

        end
    )

    return true

end

