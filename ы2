--// DeadEye loader
local BASE =
    "https://raw.githubusercontent.com/skirkzhdimenya-source/DeadEye/main/"

local ok1, part1 =
    pcall(function()
        return game:HttpGet(
            BASE .. "deadeeye_part1.lua"
        )
    end)

local ok2, part2 =
    pcall(function()
        return game:HttpGet(
            BASE .. "deadeeye_part2.lua"
        )
    end)

local ok3, part3 =
    pcall(function()
        return game:HttpGet(
            BASE .. "deadeeye_part3.lua"
        )
    end)

if not ok1 then
    error("[DeadEye] Failed to download part1: " .. tostring(part1))
end

if not ok2 then
    error("[DeadEye] Failed to download part2: " .. tostring(part2))
end

if not ok3 then
    error("[DeadEye] Failed to download part3: " .. tostring(part3))
end

local source =
    part1
    .. part2
    .. part3

local fn, compileError =
    loadstring(
        source,
        "@DeadEye"
    )

if not fn then
    error(
        "[DeadEye] Source compile error: "
        .. tostring(
            compileError
        )
    )
end

local okRun, runError =
    pcall(fn)

if not okRun then
    error(
        "[DeadEye] Runtime error: "
        .. tostring(
            runError
        )
    )
end