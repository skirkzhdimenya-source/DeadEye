local lastUnusualEquipped =
    getEquippedUnusualId()

addConnection(
    RunService.Heartbeat:Connect(
        function()

            if cleaned then
                return
            end

            if not unusualEnabled then
                return
            end

            local equipped =
                getEquippedUnusualId()

            if equipped
                ~= lastUnusualEquipped
            then

                lastUnusualEquipped =
                    equipped

                if equipped
                    == unusualSlot.originalId
                then

                    task.spawn(
                        activateUnusual
                    )

                else

                    if unusualActive then
                        restoreUnusual()
                    end

                end

            end

        end
    )
)

