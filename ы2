                    or keyCode
                        == Enum.KeyCode.Unknown
                then
                    return
                end
                if mainJump.capturing
                    == "jump"
                then
                    mainJump.setHotkey(
                        keyCode.Name
                    )
                else
                    mainJump.setHideUIHotkey(
                        keyCode.Name
                    )
                end
                return
            end

            if input.KeyCode
                == mainFindKeyCode(
                    mainJump.hotkeyName
                )
            then
                mainJump.setEnabled(
                    not mainJump.enabled
                )
            end
            if input.KeyCode
                == mainFindKeyCode(
                    mainJump.hideUIHotkeyName
                )
            then
                ScreenGui.Enabled =
                    not ScreenGui.Enabled
            end
        end
    )
)
