local CameraService = nil

pcall(function()
    local services = ReplicatedStorage:WaitForChild("Services")
    local client = services:WaitForChild("Client")
    CameraService = require(
        client:WaitForChild("CameraService")
    )
end)

local function GetCameraYaw()
    local camera = workspace.CurrentCamera

    if not camera then
        return 0
    end

    return YawFromDirection(
        camera.CFrame.LookVector
    )
end

local function SetCameraYaw(targetYaw)
    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    local currentCFrame = camera.CFrame

    local pitch = select(
        1,
        currentCFrame:ToOrientation()
    )

    local currentYaw = GetCameraYaw()

    local delta = AngleDifference(
        currentYaw,
        targetYaw
    )

    local maxStep =
        CONFIG.CameraTurnSpeed
        * CONFIG.Tick

    delta = math.clamp(
        delta,
        -maxStep,
        maxStep
    )

    local smooth =
        1 - math.exp(
            -CONFIG.CameraSmoothness
            * CONFIG.Tick
        )

    -- Не режем поворот вторым жёстким ограничением:
    -- сначала ограничивается максимальная скорость,
    -- затем только слегка сглаживаем результат.
    delta = delta * math.max(smooth, 0.35)

    local newYaw =
        currentYaw + delta

    -- IMPORTANT:
    -- pitch stays as-is
    -- yaw changes
    -- roll is ALWAYS zero
    local newCFrame =
        CFrame.new(
            currentCFrame.Position
        )
        * CFrame.Angles(
            pitch,
            newYaw,
            CONFIG.CameraRoll
        )

    if CameraService then
        local ok = pcall(function()
            CameraService:SetCFrame(
                newCFrame
            )
        end)

        if ok then
            return
        end
    end

    pcall(function()
        camera.CFrame = newCFrame
    end)
end

--==============================================================--
-- RAYCAST
--==============================================================--

local RayParams = RaycastParams.new()

RayParams.FilterType =
    Enum.RaycastFilterType.Exclude

RayParams.IgnoreWater = true
RayParams.RespectCanCollide = true

local function UpdateRayFilter()
    local list = {}

    local character =
        LocalPlayer.Character

    if character then
        table.insert(
            list,
            character
        )
    end

    -- Do not treat other player models as walls.
    local playersFolder =
        workspace:FindFirstChild("Players")

    if playersFolder then
        table.insert(
            list,
            playersFolder
        )
    end

    local effects =
        workspace:FindFirstChild("Effects")

    if effects then
        table.insert(
            list,
            effects
        )
    end

    local map =
        workspace:FindFirstChild("Map")

    if map then

        local ignore =
            map:FindFirstChild("Ignore")

        if ignore then
            table.insert(
                list,
                ignore
            )
        end

        local invis =
            map:FindFirstChild("InvisParts")

        if invis then
            table.insert(
                list,
                invis
            )
        end
    end

    RayParams.FilterDescendantsInstances =
        list

    -- Match the character's collision group.
    if character then

        local root =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        if root then

            pcall(function()
                RayParams.CollisionGroup =
                    root.CollisionGroup
            end)

        end
    end
end

UpdateRayFilter()

--==============================================================--
-- GROUND
--==============================================================--

local function GroundAt(position)
    return workspace:Raycast(
        position
        + Vector3.new(0, 6, 0),

        Vector3.new(0, -20, 0),

        RayParams
    )
end

local function IsWalkable(normal)
    if not normal then
        return false
    end

    return normal:Dot(
        Vector3.new(0, 1, 0)
    ) > 0.65
end

local function GetGroundInfo(position)
    local result =
        GroundAt(position)

    if not result then
        return nil
    end

    return {
        Position = result.Position,
        Normal = result.Normal,
        Instance = result.Instance,
    }
end

local function IsGrounded(
    root,
    humanoid
)

    local state =
        humanoid:GetState()

    if state ==
        Enum.HumanoidStateType.Running
        or state ==
        Enum.HumanoidStateType.RunningNoPhysics
        or state ==
        Enum.HumanoidStateType.Landed
    then
        return true
    end

    local ground =
        GetGroundInfo(
            root.Position
        )

    if not ground then
        return false
    end

    local distance =
        root.Position.Y
        - ground.Position.Y

    return
        distance <= 3.2
        and IsWalkable(
            ground.Normal
        )
end

--==============================================================--
-- WALL BLOCKCAST
--==============================================================--

local function WallBlockcast(
    root,
    direction,
    distance
)

    direction =
        SafeUnit(
            Flat(direction),
            Vector3.new(0, 0, -1)
        )

    local size =
        root.Size

    local castSize =
        Vector3.new(
            math.max(
                0.1,
                size.X
                * CONFIG.WallWidthMultiplier
            ),

            math.max(
                0.1,
                size.Y
                * CONFIG.WallHeightMultiplier
            ),

            math.max(
                0.1,
                size.Z
                * CONFIG.WallDepthMultiplier
            )
        )

    local result =
        workspace:Blockcast(
            root.CFrame,
            castSize,
            direction * distance,
            RayParams
        )

    if
        result
        and result.Instance
        and result.Instance.CanCollide
    then
        return result
    end

    return nil
end

--==============================================================--
-- MULTI ANGLE WALL SCAN
--==============================================================--

local function FindWallAround(
    root,
    direction
)

    direction =
        SafeUnit(
            Flat(direction),
            Vector3.new(0, 0, -1)
        )

    local baseDistance =
        math.clamp(
            root.AssemblyLinearVelocity.Magnitude
            * 0.45,
            CONFIG.WallLookAheadMin,
            CONFIG.WallLookAheadMax
        )

    local bestHit = nil

    -- Direct path first.
    local direct =
        WallBlockcast(
            root,
            direction,
            baseDistance
        )

    if direct then
        bestHit = direct
    end

    -- Then look around the direction.
    for _, degrees in ipairs(
        CONFIG.WallAngles
    ) do

        if degrees ~= 0 then

            local candidateDirection =
                RotateY(
                    direction,
                    math.rad(degrees)
                )

            local hit =
                WallBlockcast(
                    root,
                    candidateDirection,
                    baseDistance
                )

            if hit then

                if
                    not bestHit
                    or hit.Distance
                    < bestHit.Distance
                then

                    -- Keep the closest collision
                    -- as the actual threat.
                    if degrees == 0 then
                        bestHit = hit
                    end

                end
            end
        end
    end

    return bestHit
end

--==============================================================--
-- DIRECT WALL THREAT
--==============================================================--

local function GetWallThreat(
    root,
    direction
)

    local speed =
        Flat(
            root.AssemblyLinearVelocity
        ).Magnitude

    local distance =
        math.clamp(
            speed * 0.5,
            CONFIG.WallLookAheadMin,
            CONFIG.WallLookAheadMax
        )

    return WallBlockcast(
        root,
        direction,
        distance
    )
end

--==============================================================--
-- CLEARANCE
--==============================================================--

local function GetClearance(
    root,
    direction,
    distance
)

    local hit =
        WallBlockcast(
            root,
            direction,
            distance
        )

    if not hit then
        return distance, nil
    end

    return hit.Distance, hit
end

--==============================================================--
-- EXACT ACCELERATE
--==============================================================--

local function Accelerate(
    velocity,
    wishDir,
    wishSpeed,
    acceleration,
    dt
)

    local addSpeed =
        wishSpeed
        - velocity:Dot(
            wishDir
        )

    if addSpeed <= 0 then
        return velocity
    end

    local accelSpeed =
        acceleration
        * dt
        * wishSpeed

    if addSpeed > accelSpeed then
        addSpeed =
            accelSpeed
    end

    return velocity
        + wishDir
        * addSpeed
end

--==============================================================--
-- BEST AIR STRAFE
--==============================================================--
--
-- The objective is ONLY maximum horizontal speed.
--
-- No "stay straight" restriction exists.
--
-- The game does:
--   wishSpeed = min(182, ...)
--   acceleration = 182
--
-- The optimal wish direction is around perpendicular
-- to the current velocity.
--
--==============================================================--

local function GetBestAirAction(
    root,
    velocity
)

    local flatVelocity =
        Flat(velocity)

    if flatVelocity.Magnitude
        < 0.001
    then

        return {
            Side = currentSide,
            WishDir =
                Vector3.new(
                    1,
                    0,
                    0
                ),
            Score = 0,
        }
    end

    local velocityDirection =
        flatVelocity.Unit

    local wall =
        GetWallThreat(
            root,
            velocityDirection
        )

    local candidates = {}

    local function AddCandidate(
        direction,
        side
    )

        direction =
            SafeUnit(
                Flat(direction),
                velocityDirection
            )

        local predicted =
            Accelerate(
                flatVelocity,
                direction,
                PHYSICS.AirStrafeAcceleration,
                PHYSICS.AirStrafeAcceleration,
                CONFIG.Tick
            )

        local nextSpeed =
            predicted.Magnitude

        local clearance,
        hit =
            GetClearance(
                root,
                direction,
                math.clamp(
                    nextSpeed
                    * 0.45,
                    4,
                    12
                )
            )

        local score =
            nextSpeed

        -- Strongly punish an actual collision.
        if hit then

            if clearance
                <= CONFIG.WallCriticalDistance
            then

                score =
                    score
                    - 100000

            else

                score =
                    score
                    - 5000

            end

        else

            score =
                score
                + clearance * 2

        end

        -- If a wall is already threatening us,
        -- directions away from its normal are preferred.
        if wall then

            local normal =
                Flat(
                    wall.Normal
                )

            if normal.Magnitude > 0.001 then

                normal =
                    normal.Unit

                local away =
                    direction:Dot(
                        normal
                    )

                score =
                    score
                    + math.max(
                        away,
                        0
                    )
                    * 50
            end
        end

        table.insert(
            candidates,
            {
                Side = side,
                WishDir = direction,
                Velocity = predicted,
                Score = score,
                Clearance = clearance,
                Hit = hit,
            }
        )
    end

    -- Main optimal directions.
    AddCandidate(
        RotateY(
            velocityDirection,
            math.rad(90)
        ),
        1
    )

    AddCandidate(
        RotateY(
            velocityDirection,
            math.rad(-90)
        ),
        -1
    )

    -- Additional angles for wall avoidance.
    local angles = {
        60,
        -60,
        70,
        -70,
        80,
        -80,
        100,
        -100,
        110,
        -110,
        45,
        -45,
        30,
        -30,
    }

    for _, angle in ipairs(
        angles
    ) do

        local side

        if angle > 0 then
            side = 1
        else
            side = -1
        end

        AddCandidate(
            RotateY(
                velocityDirection,
                math.rad(angle)
            ),
            side
        )

    end

    local best = nil

    for _, candidate in ipairs(
        candidates
    ) do

        if
            not best
            or candidate.Score
            > best.Score
        then

            best =
                candidate

        end
    end

    if not best then
        return nil
    end

    -- Convert desired WORLD wishDir into camera yaw.
    local cameraYaw

    if best.Side > 0 then

        -- D:
        -- camera RightVector = wishDir
        cameraYaw =
            math.atan2(
                -best.WishDir.Z,
                best.WishDir.X
            )

    else

        -- A:
        -- camera RightVector = -wishDir
        cameraYaw =
            math.atan2(
                best.WishDir.Z,
                -best.WishDir.X
            )

    end

    best.CameraYaw =
        cameraYaw

    return best
end

--==============================================================--
-- GROUND DIRECTION
--==============================================================--

local function GetBestGroundDirection(
    root,
    velocity,
    cameraForward
)

    local base =
        SafeUnit(
            Flat(velocity),
            cameraForward
        )

    local candidates = {}

    local function Add(
        direction
    )

        direction =
            SafeUnit(
                Flat(direction),
                base
            )

        local clearance,
        hit =
            GetClearance(
                root,
                direction,
                9
            )

        local forwardScore =
            direction:Dot(base)

        local score =
            forwardScore
            * 100
            + clearance * 3

        if hit then
            score =
                score
                - 10000
        else
            score =
                score
                + 100
        end

        table.insert(
            candidates,
            {
                Direction = direction,
                Score = score,
                Clearance = clearance,
                Hit = hit,
            }
        )
    end

    Add(base)
    Add(RotateY(base, math.rad(15)))
    Add(RotateY(base, math.rad(-15)))
    Add(RotateY(base, math.rad(30)))
    Add(RotateY(base, math.rad(-30)))
    Add(RotateY(base, math.rad(45)))
    Add(RotateY(base, math.rad(-45)))
    Add(RotateY(base, math.rad(65)))
    Add(RotateY(base, math.rad(-65)))

    local best = candidates[1]

    for _, candidate in ipairs(
        candidates
    ) do

        if candidate.Score
            > best.Score
        then

            best =
                candidate

        end
    end

    return best
end

--==============================================================--
-- TERRAIN JUMP
--==============================================================--

local function TerrainNeedsJump(
    root,
    direction
)

    direction =
        SafeUnit(
            Flat(direction),
            Vector3.new(
                0,
                0,
                -1
            )
        )

    local current =
        GetGroundInfo(
            root.Position
        )

    if not current then
        return false
    end

    local near =
        GetGroundInfo(
            root.Position
            + direction
            * CONFIG.GroundLookAhead
        )

    local far =
        GetGroundInfo(
            root.Position
            + direction
            * CONFIG.GroundLookAheadFar
        )

    -- No floor ahead.
    if not near then
        return true
    end

    -- Drop ahead.
    local drop =
        current.Position.Y
        - near.Position.Y

    if drop >
        CONFIG.MaxDrop
    then
        return true
    end

    -- Step / ledge ahead.
    local rise =
        near.Position.Y
        - current.Position.Y

    if rise >
        CONFIG.MaxStep
    then
        return true
    end

    -- Far obstacle.
    if far then

        local farRise =
            far.Position.Y
            - current.Position.Y

        if farRise >
            CONFIG.MaxStep
        then
            return true
        end

    end

    return false
end

--==============================================================--
-- WALL ESCAPE
--==============================================================--

local function GetWallEscapeDirection(
    root,
    velocity
)

    local direction =
        SafeUnit(
            Flat(velocity),
            Vector3.new(
                0,
                0,
                -1
            )
        )

    local wall =
        GetWallThreat(
            root,
            direction
        )

    if not wall then
        return nil
    end

    local normal =
        Flat(
            wall.Normal
        )

    if normal.Magnitude
        < 0.001
    then
        return nil
    end

    normal =
        normal.Unit

    local tangent =
        Vector3.new(
            -normal.Z,
            0,
            normal.X
        )

    local candidates = {
        tangent,
        -tangent,
        normal,
        SafeUnit(
            tangent + normal,
            normal
        ),
        SafeUnit(
            -tangent + normal,
            normal
        ),
    }

    local best = nil

    for _, candidate in ipairs(
        candidates
    ) do

        local clearance,
        hit =
            GetClearance(
                root,
                candidate,
                8
            )

        local forwardAmount =
            candidate:Dot(
                direction
            )

        local score =
            clearance * 5
            + forwardAmount * 20

        if hit then
            score =
                score
                - 10000
        else
            score =
                score
                + 100
        end

        if
            not best
            or score > best.Score
        then

            best = {
                Direction = candidate,
                Score = score,
                Clearance = clearance,
            }

        end
    end

    if best then
        return best.Direction
    end

    return nil
end

--==============================================================--
-- PATH PREDICTION
--==============================================================--

local function PredictPath()

    local character =
        LocalPlayer.Character

    if not character then
        return {}
    end

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not root
        or not humanoid
    then
        return {}
    end

    local position =
        root.Position

    local velocity =
        Flat(
            root.AssemblyLinearVelocity
        )

    local internalVelocity =
        velocity
        * PHYSICS.Scale

    if internalVelocity.Magnitude
        < 10
    then

        local camera =
            workspace.CurrentCamera

        internalVelocity =
            SafeUnit(
                Flat(
                    camera.CFrame.LookVector
                ),
                Vector3.new(
                    0,
                    0,
                    -1
                )
            )
            * PHYSICS.Speed

    end

    local gravity =
        workspace.Gravity

    local vertical =
        math.sqrt(
            2
            * gravity
            * PHYSICS.JumpHeight
        )

    local points = {
        position
    }

    local travelled = 0

    local nextPoint =
        CONFIG.PathPointSpacing

    local side =
        currentSide

    for step = 1, 12000 do

        if ENV.StrafeControllerStop then
            return points
        end

        --======================================================--
        -- AIR STRAFE
        --======================================================--

        local action =
            GetBestAirAction(
                root,
                internalVelocity
                / PHYSICS.Scale
            )

        if action then
            side =
                action.Side

            internalVelocity =
                action.Velocity
        end

        --======================================================--
        -- GRAVITY
        --======================================================--

        vertical =
            vertical
            - gravity
            * CONFIG.Tick

        --======================================================--
        -- REAL VELOCITY
        --======================================================--

        local horizontal =
            internalVelocity
            / PHYSICS.Scale

        local frameVelocity =
            horizontal
            + Vector3.new(
                0,
                vertical,
                0
            )

        local newPosition =
            position
            + frameVelocity
            * CONFIG.Tick

        --======================================================--
        -- WALL COLLISION
        --======================================================--

        local movement =
            Flat(
                newPosition
                - position
            )

        if movement.Magnitude > 0 then

            local wall =
                WallBlockcast(
                    root,
                    movement.Unit,
                    movement.Magnitude + 1
                )

            if wall then

                local normal =
                    Flat(
                        wall.Normal
                    )

                if normal.Magnitude
                    > 0.001
                then

                    normal =
                        normal.Unit

                    local tangent =
                        Vector3.new(
                            -normal.Z,
                            0,
                            normal.X
                        )

                    local leftClear =
                        GetClearance(
                            root,
                            tangent,
                            8
                        )

                    local rightClear =
                        GetClearance(
                            root,
                            -tangent,
                            8
                        )

                    local escape

                    if leftClear
                        > rightClear
                    then

                        escape =
                            tangent

                    else

                        escape =
                            -tangent

                    end

                    internalVelocity =
                        Accelerate(
                            internalVelocity,
                            escape,
                            PHYSICS.AirStrafeAcceleration,
                            PHYSICS.AirStrafeAcceleration,
                            CONFIG.Tick
                        )

                    horizontal =
                        internalVelocity
                        / PHYSICS.Scale

                    frameVelocity =
                        horizontal
                        + Vector3.new(
                            0,
                            vertical,
                            0
                        )

                    newPosition =
                        position
                        + frameVelocity
                        * CONFIG.Tick

                end
            end
        end

        --======================================================--
        -- TERRAIN
        --======================================================--

        local ground =
            GroundAt(
                newPosition
            )

        if
            ground
            and IsWalkable(
                ground.Normal
            )
        then

            local floorY =
                ground.Position.Y
                + 2

            if newPosition.Y
                <= floorY
            then

                newPosition =
                    Vector3.new(
                        newPosition.X,
                        floorY,
                        newPosition.Z
                    )

                internalVelocity =
                    ApplyFriction(
                        internalVelocity,
                        CONFIG.Tick,
                        1
                    )

                vertical =
                    math.sqrt(
                        2
                        * gravity
                        * PHYSICS.JumpHeight
                    )

                side =
                    -side

            end
        end

        --======================================================--
        -- DISTANCE
        --======================================================--

        local delta =
            Flat(
                newPosition
                - position
            )

        local stepDistance =
            delta.Magnitude

        local oldDistance =
            travelled

        travelled =
            travelled
            + stepDistance

        --======================================================--
        -- POINTS
        --======================================================--

        if stepDistance > 0 then

            while
                nextPoint <= travelled
                and nextPoint
                    <= CONFIG.PathDistance
            do

                local alpha =
                    (
                        nextPoint
                        - oldDistance
                    )
                    / stepDistance

                alpha =
                    math.clamp(
                        alpha,
                        0,
                        1
                    )

                table.insert(
                    points,
                    position:Lerp(
                        newPosition,
                        alpha
                    )
                )

                nextPoint =
                    nextPoint
                    + CONFIG.PathPointSpacing
            end
        end

        position =
            newPosition

        if travelled
            >= CONFIG.PathDistance
        then
            break
        end
    end

    return points
end

