--==============================================================--
-- MAIN CONTROL
--==============================================================--

local function ControllerUpdate()

    if ENV.StrafeControllerStop then
        Cleanup()
        return
    end

    if not ENV.StrafeControllerEnabled then
        return
    end

    local now =
        os.clock()

    if now - lastTick
        < CONFIG.Tick
    then
        return
    end

    lastTick =
        now

    local character =
        LocalPlayer.Character

    if not character then
        ReleaseAllKeys()
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not humanoid
        or not root
        or humanoid.Health <= 0
    then

        ReleaseAllKeys()

        return
    end

    -- Raycast filter is cached and refreshed on character changes.
    -- Rebuilding FilterDescendantsInstances every frame was needless
    -- overhead.

    --==========================================================--
    -- VELOCITY
    --==========================================================--

    local velocity =
        Flat(
            root.AssemblyLinearVelocity
        )

    local speed =
        velocity.Magnitude

    local camera =
        workspace.CurrentCamera

    if not camera then
        return
    end

    local cameraForward =
        SafeUnit(
            Flat(
                camera.CFrame.LookVector
            ),
            Vector3.new(
                0,
                0,
                -1
            )
        )

    local movementDirection

    if speed > 0.5 then
        movementDirection =
            velocity.Unit
    else
        movementDirection =
            cameraForward
    end

    --==========================================================--
    -- GROUNDED
    --==========================================================--

    local grounded =
        IsGrounded(
            root,
            humanoid
        )

    --==========================================================--
    -- GROUND
    --==========================================================--

    if grounded then

        -- Ground movement is supplied directly to the
        -- game's ControlModule as W.
        ForcedMoveDirection =
            Vector3.new(
                0,
                0,
                -1
            )

        SetKey(
            "W",
            KEY_W,
            false
        )

        ReleaseStrafe()

        --======================================================--
        -- TERRAIN / WALL
        --======================================================--

        local groundAction =
            GetBestGroundDirection(
                root,
                velocity,
                cameraForward
            )

        local targetDirection =
            groundAction.Direction

        local wallEscape = nil

        if groundAction.Hit then
            wallEscape =
                GetWallEscapeDirection(
                    root,
                    velocity,
                    groundAction.Hit
                )
        end

        if wallEscape then
            targetDirection =
                wallEscape
        end

        --======================================================--
        -- CAMERA
        --======================================================--

        SetCameraYaw(
            YawFromDirection(
                targetDirection
            )
        )

        --======================================================--
        -- JUMP CONDITIONS
        --======================================================--

        local terrainJump =
            TerrainNeedsJump(
                root,
                targetDirection
            )

        local wall = nil

        if not CONFIG.AutoBhop then
            wall =
                GetWallThreat(
                    root,
                    targetDirection
                )
        end

        if CONFIG.AutoBhop then

            DoJump()

        elseif terrainJump
            or wall
        then

            DoJump()

        end

    else

        --======================================================--
        -- AIR
        --======================================================--

        -- Air movement is intentionally pure A/D.
        -- test2 detects this as the special AirStrafe branch
        -- only when MoveDirection.Z == 0 and X ~= 0.
        if currentSide > 0 then
            ForcedMoveDirection =
                Vector3.new(
                    1,
                    0,
                    0
                )
        else
            ForcedMoveDirection =
                Vector3.new(
                    -1,
                    0,
                    0
                )
        end

        SetKey(
            "W",
            KEY_W,
            false
        )

        --======================================================--
        -- CHOOSE AIR ACTION
        --======================================================--

        local action =
            GetBestAirAction(
                root,
                velocity
            )

        if action then

            currentSide =
                action.Side

            --==================================================--
            -- WALL OVERRIDE
            --==================================================--

            local escape = nil

            if action.Wall then
                escape =
                    GetWallEscapeDirection(
                        root,
                        velocity,
                        action.Wall
                    )
            end

            if escape then

                -- Try to keep the chosen A/D side,
                -- but point its camera toward the escape.
                local escapeAction =
                    {
                        WishDir = escape,
                        Side =
                            currentSide,
                    }

                if currentSide > 0 then

                    escapeAction.CameraYaw =
                        math.atan2(
                            -escape.Z,
                            escape.X
                        )

                else

                    escapeAction.CameraYaw =
                        math.atan2(
                            escape.Z,
                            -escape.X
                        )

                end

                SetCameraYaw(
                    escapeAction.CameraYaw
                )

            else

                SetCameraYaw(
                    action.CameraYaw
                )

            end

            ApplyStrafe()

        else

            ApplyStrafe()

        end

    end

    --==========================================================--
    -- LANDING
    --==========================================================--

    if grounded
        and not wasGrounded
    then

        currentSide =
            -currentSide

        if CONFIG.AutoBhop then
            DoJump()
        end

    end

    wasGrounded =
        grounded

    --==========================================================--
    -- PATH
    --==========================================================--

    if CONFIG.DrawPath then

        if now - lastPathUpdate
            >= CONFIG.PathUpdateInterval
        then

            lastPathUpdate =
                now

            local points =
                PredictPath()

            DrawPath(
                points
            )

        end

    else

        ClearLines()

    end

end

--==============================================================--
-- CLEANUP
--==============================================================--

local function CleanupInternal()

    if cleanupDone then
        return
    end

    cleanupDone =
        true

    ENV.StrafeControllerStop =
        true

    ENV.StrafeControllerEnabled =
        false

    ReleaseAllKeys()

    ForcedMoveDirection =
        Vector3.new(
            0,
            0,
            0
        )

    ClearLines()

    pcall(function()
        RunService:UnbindFromRenderStep(
            "DeadEyeAutoStrafe"
        )
    end)

    if InputConnection then
        InputConnection:Disconnect()
        InputConnection = nil
    end

    if CharacterConnection then
        CharacterConnection:Disconnect()
        CharacterConnection = nil
    end

    if DragConnection then
        DragConnection:Disconnect()
        DragConnection = nil
    end

    if DragEndConnection then
        DragEndConnection:Disconnect()
        DragEndConnection = nil
    end

    for _, line in ipairs(
        Lines
    ) do

        pcall(function()
            line:Remove()
        end)

    end

    Lines = {}

    if ScreenGui then
        ScreenGui:Destroy()
    end

    RestoreGameInputHooks()

    ENV.__DeadEyeStrafeControllerCleanup =
        nil

end

Cleanup = CleanupInternal

ENV.__DeadEyeStrafeControllerCleanup =
    CleanupInternal

Close.MouseButton1Click:Connect(
    CleanupInternal
)

--==============================================================--
-- START
--==============================================================--

SetEnabled(
    CONFIG.StartEnabled
)

RunService:BindToRenderStep(
    "DeadEyeAutoStrafe",
    Enum.RenderPriority.Camera.Value + 1,
    function()

        if cleanupDone then
            return
        end

        ControllerUpdate()

    end
)