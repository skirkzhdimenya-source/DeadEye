local function InstallGameInputHooks()

    if GameHooksInstalled then
        return
    end

    if not ControlModule
        or type(
            ControlModule.GetMoveVector
        ) ~= "function"
    then
        return
    end

    if not CameraService
        or type(
            CameraService.GetCFrame
        ) ~= "function"
    then
        return
    end

    OriginalControlGetMoveVector =
        ControlModule.GetMoveVector

    OriginalCameraGetCFrame =
        CameraService.GetCFrame

    local camera =
        workspace.CurrentCamera

    if camera then

        ControlledCameraCFrame =
            camera.CFrame

        pcall(function()
            local original =
                OriginalCameraGetCFrame(
                    CameraService
                )

            if typeof(original)
                == "CFrame"
            then
                ControlledCameraCFrame =
                    original
            end
        end)
    end

    ControlModule.GetMoveVector =
        function(self, ...)

            if cleanupDone
                or not ENV.StrafeControllerEnabled
            then
                return OriginalControlGetMoveVector(
                    self,
                    ...
                )
            end

            return ForcedMoveDirection
        end

    CameraService.GetCFrame =
        function(self, ...)

            if cleanupDone
                or not ENV.StrafeControllerEnabled
                or not ControlledCameraCFrame
            then
                return OriginalCameraGetCFrame(
                    self,
                    ...
                )
            end

            return ControlledCameraCFrame
        end

    GameHooksInstalled = true
end

local function RestoreGameInputHooks()

    if not GameHooksInstalled then
        return
    end

    if ControlModule
        and OriginalControlGetMoveVector
    then

        pcall(function()
            ControlModule.GetMoveVector =
                OriginalControlGetMoveVector
        end)

    end

    if CameraService
        and OriginalCameraGetCFrame
    then

        pcall(function()
            CameraService.GetCFrame =
                OriginalCameraGetCFrame
        end)

    end

    GameHooksInstalled = false
    OriginalControlGetMoveVector = nil
    OriginalCameraGetCFrame = nil
    ControlledCameraCFrame = nil
end

local function GetCameraYaw()
    local currentCFrame =
        ControlledCameraCFrame

    if not currentCFrame then

        local camera =
            workspace.CurrentCamera

        if not camera then
            return 0
        end

        currentCFrame =
            camera.CFrame
    end

    return YawFromDirection(
        currentCFrame.LookVector
    )
end

local function SetCameraYaw(targetYaw)
    local camera =
        workspace.CurrentCamera

    if not camera then
        return
    end

    if type(targetYaw) ~= "number" then
        return
    end

    local currentCFrame =
        ControlledCameraCFrame

    if not currentCFrame then
        currentCFrame =
            camera.CFrame
    end

    local pitch =
        select(
            1,
            currentCFrame:ToOrientation()
        )

    local currentYaw =
        GetCameraYaw()

    local delta = AngleDifference(
        currentYaw,
        targetYaw
    )

    local maxStep =
        CONFIG.CameraTurnSpeed
        * CONFIG.Tick

    delta = math.clamp(
        delta,
        -maxStep,
        maxStep
    )

    local smooth =
        1 - math.exp(
            -CONFIG.CameraSmoothness
            * CONFIG.Tick
        )

    -- Не режем поворот вторым жёстким ограничением:
    -- сначала ограничивается максимальная скорость,
    -- затем только слегка сглаживаем результат.
    delta = delta * smooth

    local newYaw =
        currentYaw + delta

    -- IMPORTANT:
    -- pitch stays as-is
    -- yaw changes
    -- roll is ALWAYS zero
    local newCFrame =
        CFrame.new(
            camera.CFrame.Position
        )
        * CFrame.Angles(
            pitch,
            newYaw,
            CONFIG.CameraRoll
        )

    ControlledCameraCFrame =
        newCFrame

    if CameraService then
        local ok = pcall(function()
            CameraService:SetCFrame(
                newCFrame
            )
        end)

        if ok then
            return
        end
    end

    pcall(function()
        camera.CFrame = newCFrame
    end)
end

--==============================================================--
-- RAYCAST
--==============================================================--

local RayParams = RaycastParams.new()

RayParams.FilterType =
    Enum.RaycastFilterType.Exclude

RayParams.IgnoreWater = true
RayParams.RespectCanCollide = true

local function UpdateRayFilter(force)
    local list = {}

    local character =
        LocalPlayer.Character

    local root =
        character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not force
        and character == CachedFilterCharacter
        and root == CachedFilterRoot
    then
        return
    end

    if character then
        table.insert(
            list,
            character
        )
    end

    -- Do not treat other player models as walls.
    local playersFolder =
        workspace:FindFirstChild("Players")

    if playersFolder then
        table.insert(
            list,
            playersFolder
        )
    end

    local effects =
        workspace:FindFirstChild("Effects")

    if effects then
        table.insert(
            list,
            effects
        )
    end

    local map =
        workspace:FindFirstChild("Map")

    if map then

        local ignore =
            map:FindFirstChild("Ignore")

        if ignore then
            table.insert(
                list,
                ignore
            )
        end

        local invis =
            map:FindFirstChild("InvisParts")

        if invis then
            table.insert(
                list,
                invis
            )
        end
    end

    RayParams.FilterDescendantsInstances =
        list

    -- Match the character's collision group.
    if root then

        pcall(function()
            RayParams.CollisionGroup =
                root.CollisionGroup
        end)

    end

    CachedFilterCharacter = character
    CachedFilterRoot = root
end

UpdateRayFilter()

--==============================================================--
-- GROUND
--==============================================================--

local function GroundAt(position)
    return workspace:Raycast(
        position
        + Vector3.new(0, 6, 0),

        Vector3.new(0, -20, 0),

        RayParams
    )
end

local function IsWalkable(normal)
    if not normal then
        return false
    end

    return normal:Dot(
        Vector3.new(0, 1, 0)
    ) > 0.65
end

local function GetGroundInfo(position)
    local result =
        GroundAt(position)

    if not result then
        return nil
    end

    return {
        Position = result.Position,
        Normal = result.Normal,
        Instance = result.Instance,
    }
end

local function IsGrounded(
    root,
    humanoid
)

    local state =
        humanoid:GetState()

    if state ==
        Enum.HumanoidStateType.Running
        or state ==
        Enum.HumanoidStateType.RunningNoPhysics
        or state ==
        Enum.HumanoidStateType.Landed
    then
        return true
    end

    local ground =
        GetGroundInfo(
            root.Position
        )

    if not ground then
        return false
    end

    local distance =
        root.Position.Y
        - ground.Position.Y

    return
        distance <= 3.2
        and IsWalkable(
            ground.Normal
        )
end

--==============================================================--
-- WALL BLOCKCAST
--==============================================================--

local function WallBlockcastAt(
    root,
    castCFrame,
    direction,
    distance
)

    direction =
        SafeUnit(
            Flat(direction),
            Vector3.new(0, 0, -1)
        )

    local size =
        root.Size

    local castSize =
        Vector3.new(
            math.max(
                0.1,
                size.X
                * CONFIG.WallWidthMultiplier
            ),

            math.max(
                0.1,
                size.Y
                * CONFIG.WallHeightMultiplier
            ),

            math.max(
                0.1,
                size.Z
                * CONFIG.WallDepthMultiplier
            )
        )

    local result =
        workspace:Blockcast(
            castCFrame,
            castSize,
            direction * distance,
            RayParams
        )

    if
        result
        and result.Instance
        and result.Instance.CanCollide
    then
        return result
    end

    return nil
end

local function WallBlockcast(
    root,
    direction,
    distance
)
    return WallBlockcastAt(
        root,
        root.CFrame,
        direction,
        distance
    )
end

--==============================================================--
-- MULTI ANGLE WALL SCAN
--==============================================================--

local function FindWallAround(
    root,
    direction
)

    direction =
        SafeUnit(
            Flat(direction),
            Vector3.new(0, 0, -1)
        )

    local baseDistance =
        math.clamp(
            root.AssemblyLinearVelocity.Magnitude
            * 0.45,
            CONFIG.WallLookAheadMin,
            CONFIG.WallLookAheadMax
        )

    local bestHit = nil

    -- Direct path first.
    local direct =
        WallBlockcast(
            root,
            direction,
            baseDistance
        )

    if direct then
        bestHit = direct
    end

    -- Then look around the direction.
    for _, degrees in ipairs(
        CONFIG.WallAngles
    ) do

        if degrees ~= 0 then

            local candidateDirection =
                RotateY(
                    direction,
                    math.rad(degrees)
                )

            local hit =
                WallBlockcast(
                    root,
                    candidateDirection,
                    baseDistance
                )

            if hit then

                if
                    not bestHit
                    or hit.Distance
                    < bestHit.Distance
                then

                    -- Keep the closest collision
                    -- from any scanned angle.
                    bestHit = hit

                end
            end
        end
    end

    return bestHit
end

--==============================================================--
-- DIRECT WALL THREAT
--==============================================================--

local function GetWallThreat(
    root,
    direction
)

    local speed =
        Flat(
            root.AssemblyLinearVelocity
        ).Magnitude

    local distance =
        math.clamp(
            speed * 0.5,
            CONFIG.WallLookAheadMin,
            CONFIG.WallLookAheadMax
        )

    return WallBlockcast(
        root,
        direction,
        distance
    )
end

--==============================================================--
-- CLEARANCE
--==============================================================--

local function GetClearance(
    root,
    direction,
    distance,
    castCFrame
)

    local hit =
        WallBlockcastAt(
            root,
            castCFrame
            or root.CFrame,
            direction,
            distance
        )

    if not hit then
        return distance, nil
    end

    return hit.Distance, hit
end

--==============================================================--
-- FRICTION
--==============================================================--
--
-- Predictor-side equivalent of the game's friction step.
-- The game calls Helpers:ApplyFriction() from Run/Air.
-- test3 did not have a local implementation, so PredictPath()
-- was crashing as soon as its simulated state touched the ground.
--
-- multiplier:
--   1.0 = normal ground/air friction
--   smaller values = reduced friction (used by Slide in game)
--
--==============================================================--

local function ApplyFriction(
    velocity,
    dt,
    multiplier
)

    multiplier =
        tonumber(multiplier)
        or 1

    if multiplier < 0 then
        multiplier = 0
    end

    local flatVelocity =
        Flat(velocity)

    local speed =
        flatVelocity.Magnitude

    if speed < 0.00001 then
        return velocity
    end

    local controlSpeed =
        math.max(
            speed,
            PHYSICS.RunDeaccel
        )

    local drop =
        controlSpeed
        * PHYSICS.Friction
        * dt
        * multiplier

    local newSpeed =
        math.max(
            speed - drop,
            0
        )

    if newSpeed <= 0 then
        return Vector3.new(
            0,
            velocity.Y,
            0
        )
    end

    local scale =
        newSpeed / speed

    return Vector3.new(
        flatVelocity.X * scale,
        velocity.Y,
        flatVelocity.Z * scale
    )
end

--==============================================================--
-- EXACT ACCELERATE
--==============================================================--

local function Accelerate(
    velocity,
    wishDir,
    wishSpeed,
    acceleration,
    dt
)

    local addSpeed =
        wishSpeed
        - velocity:Dot(
            wishDir
        )

    if addSpeed <= 0 then
        return velocity
    end

    local accelSpeed =
        acceleration
        * dt
        * wishSpeed

    if addSpeed > accelSpeed then
        addSpeed =
            accelSpeed
    end

    return velocity
        + wishDir
        * addSpeed
end

--==============================================================--
-- BEST AIR STRAFE
--==============================================================--
--
-- The objective is ONLY maximum horizontal speed.
--
-- No "stay straight" restriction exists.
--
-- The game does:
--   wishSpeed = min(182, ...)
--   acceleration = 182
--
-- The optimal wish direction is around perpendicular
-- to the current velocity.
--
--==============================================================--

local function GetBestAirAction(
    root,
    velocity
)

    local flatVelocity =
        Flat(velocity)

    if flatVelocity.Magnitude
        < 0.001
    then

        local fallbackWishDir =
            Vector3.new(
                1,
                0,
                0
            )

        local fallbackSide = currentSide
        if fallbackSide ~= 1
            and fallbackSide ~= -1
        then
            fallbackSide = 1
        end

        local fallbackCameraYaw

        if fallbackSide > 0 then
            fallbackCameraYaw =
                math.atan2(
                    -fallbackWishDir.Z,
                    fallbackWishDir.X
                )
        else
            fallbackCameraYaw =
                math.atan2(
                    fallbackWishDir.Z,
                    -fallbackWishDir.X
                )
        end

        return {
            Side = fallbackSide,
            WishDir = fallbackWishDir,
            Score = 0,
            CameraYaw = fallbackCameraYaw,
            Wall = nil,
        }
    end

    local velocityDirection =
        flatVelocity.Unit

    -- The game's movement code works in internal velocity
    -- units and BaseMover converts them by /90.
    local internalVelocity =
        flatVelocity
        * PHYSICS.Scale

    -- One cheap collision check first.
    -- Open space is by far the common case, so do not run
    -- ten extra Blockcasts just to prove that there is no wall.
    local wall =
        GetWallThreat(
            root,
            velocityDirection
        )

    local candidates = {}

    local function AddCandidate(
        direction,
        side
    )

        direction =
            SafeUnit(
                Flat(direction),
                velocityDirection
            )

        local predictedInternal =
            Accelerate(
                internalVelocity,
                direction,
                PHYSICS.AirStrafeAcceleration,
                PHYSICS.AirStrafeAcceleration,
                CONFIG.Tick
            )

        local predicted =
            predictedInternal
            / PHYSICS.Scale

        local nextSpeed =
            predicted.Magnitude

        local clearance =
            CONFIG.WallLookAheadMax

        local hit = nil

        if wall then

            clearance,
            hit = GetClearance(
                root,
                direction,
                math.clamp(
                    nextSpeed * 0.45,
                    4,
                    12
                )
            )
        end

        local score =
            nextSpeed

        if hit then

            if clearance
                <= CONFIG.WallCriticalDistance
            then
                score =
                    score
                    - 100000
            else
                score =
                    score
                    - 5000
            end

        elseif wall then

            score =
                score
                + clearance * 2
        end

        if wall then

            local normal =
                Flat(
                    wall.Normal
                )

            if normal.Magnitude > 0.001 then

                normal =
                    normal.Unit

                local away =
                    direction:Dot(
                        normal
                    )

                score =
                    score
                    + math.max(
                        away,
                        0
                    )
                    * 50
            end
        end

        table.insert(
            candidates,
            {
                Side = side,
                WishDir = direction,
                Velocity = predicted,
                Score = score,
                Clearance = clearance,
                Hit = hit,
            }
        )
    end

    -- Always test the two mathematically optimal strafe sides.
    AddCandidate(
        RotateY(
            velocityDirection,
            math.rad(90)
        ),
        1
    )

    AddCandidate(
        RotateY(
            velocityDirection,
            math.rad(-90)
        ),
        -1
    )

    -- Only spend extra Blockcasts when a wall is actually
    -- threatening the current velocity.
    if wall then

        local angles = {
            75,
            -75,
            60,
            -60,
            45,
            -45,
            30,
            -30,
        }

        for _, angle in ipairs(
            angles
        ) do

            local side

            if angle > 0 then
                side = 1
            else
                side = -1
            end

            AddCandidate(
                RotateY(
                    velocityDirection,
                    math.rad(angle)
                ),
                side
            )
        end
    end

    local best = nil

    for _, candidate in ipairs(
        candidates
    ) do

        local betterScore =
            not best
            or candidate.Score
            > best.Score

        local sameScore =
            best
            and math.abs(
                candidate.Score
                - best.Score
            ) < 0.0001

        local betterTieBreak =
            sameScore
            and candidate.Side
                == currentSide
            and best.Side
                ~= currentSide

        if betterScore
            or betterTieBreak
        then
            best =
                candidate
        end
    end

    if not best then
        return nil
    end

    local cameraYaw

    if best.Side > 0 then

        cameraYaw =
            math.atan2(
                -best.WishDir.Z,
                best.WishDir.X
            )

    else

        cameraYaw =
            math.atan2(
                best.WishDir.Z,
                -best.WishDir.X
            )

    end

    best.CameraYaw =
        cameraYaw

    best.Wall =
        wall

    return best
end

--==============================================================--
-- GROUND DIRECTION
--==============================================================--

local function GetBestGroundDirection(
    root,
    velocity,
    cameraForward
)

    local base =
        SafeUnit(
            Flat(velocity),
            cameraForward
        )

    -- In open space, going straight is always the best ground
    -- choice. Check the direct route first and only scan angles
    -- when a wall is actually present.
    local directWall =
        GetWallThreat(
            root,
            base
        )

    if not directWall then
        return {
            Direction = base,
            Score = 103,
            Clearance = CONFIG.WallLookAheadMax,
            Hit = nil,
        }
    end

    local candidates = {}

    local function Add(
        direction
    )

        direction =
            SafeUnit(
                Flat(direction),
                base
            )

        local clearance,
        hit =
            GetClearance(
                root,
                direction,
                9
            )

        local forwardScore =
            direction:Dot(base)

        local score =
            forwardScore
            * 100
            + clearance * 3

        if hit then
            score =
                score
                - 10000
        else
            score =
                score
                + 100
        end

        table.insert(
            candidates,
            {
                Direction = direction,
                Score = score,
                Clearance = clearance,
                Hit = hit,
            }
        )
    end

    Add(base)
    Add(RotateY(base, math.rad(15)))
    Add(RotateY(base, math.rad(-15)))
    Add(RotateY(base, math.rad(30)))
    Add(RotateY(base, math.rad(-30)))
    Add(RotateY(base, math.rad(45)))
    Add(RotateY(base, math.rad(-45)))
    Add(RotateY(base, math.rad(65)))
    Add(RotateY(base, math.rad(-65)))

    local best =
        candidates[1]

    for _, candidate in ipairs(
        candidates
    ) do

        if candidate.Score
            > best.Score
        then

            best =
                candidate

        end
    end

    return best
end

--==============================================================--
-- TERRAIN JUMP
--==============================================================--

local function TerrainNeedsJump(
    root,
    direction
)

    direction =
        SafeUnit(
            Flat(direction),
            Vector3.new(
                0,
                0,
                -1
            )
        )

    local current =
        GetGroundInfo(
            root.Position
        )

    if not current then
        return false
    end

    local near =
        GetGroundInfo(
            root.Position
            + direction
            * CONFIG.GroundLookAhead
        )

    local far =
        GetGroundInfo(
            root.Position
            + direction
            * CONFIG.GroundLookAheadFar
        )

    -- No floor ahead.
    if not near then
        return true
    end

    -- Drop ahead.
    local drop =
        current.Position.Y
        - near.Position.Y

    if drop >
        CONFIG.MaxDrop
    then
        return true
    end

    -- Step / ledge ahead.
    local rise =
        near.Position.Y
        - current.Position.Y

    if rise >
        CONFIG.MaxStep
    then
        return true
    end

    -- Far obstacle.
    if far then

        local farRise =
            far.Position.Y
            - current.Position.Y

        if farRise >
            CONFIG.MaxStep
        then
            return true
        end

    end

    return false
end

--==============================================================--
-- WALL ESCAPE
--==============================================================--

local function GetWallEscapeDirection(
    root,
    velocity,
    existingWall
)

    local direction =
        SafeUnit(
            Flat(velocity),
            Vector3.new(
                0,
                0,
                -1
            )
        )

    local wall =
        existingWall

    if wall == nil then
        wall =
            GetWallThreat(
                root,
                direction
            )
    end

    if not wall then
        return nil
    end

    local normal =
        Flat(
            wall.Normal
        )

    if normal.Magnitude
        < 0.001
    then
        return nil
    end

    normal =
        normal.Unit

    local tangent =
        Vector3.new(
            -normal.Z,
            0,
            normal.X
        )

    local candidates = {
        tangent,
        -tangent,
        normal,
        SafeUnit(
            tangent + normal,
            normal
        ),
        SafeUnit(
            -tangent + normal,
            normal
        ),
    }

    local best = nil

    for _, candidate in ipairs(
        candidates
    ) do

        local clearance,
        hit =
            GetClearance(
                root,
                candidate,
                8
            )

        local forwardAmount =
            candidate:Dot(
                direction
            )

        local score =
            clearance * 5
            + forwardAmount * 20

        if hit then
            score =
                score
                - 10000
        else
            score =
                score
                + 100
        end

        if
            not best
            or score > best.Score
        then

            best = {
                Direction = candidate,
                Score = score,
                Clearance = clearance,
            }

        end
    end

    if best then
        return best.Direction
    end

    return nil
end

--==============================================================--
-- PATH PREDICTION
--==============================================================--

local function GetPredictionAirAction(
    internalVelocity,
    side,
    dt
)

    local flatVelocity =
        Flat(
            internalVelocity
        )

    if flatVelocity.Magnitude
        < 0.001
    then
        return internalVelocity,
            Vector3.new(
                0,
                0,
                -1
            )
    end

    local velocityDirection =
        flatVelocity.Unit

    local strafeAngle

    if side > 0 then
        strafeAngle =
            math.rad(90)
    else
        strafeAngle =
            math.rad(-90)
    end

    local wishDirection =
        RotateY(
            velocityDirection,
            strafeAngle
        )

    local predicted =
        Accelerate(
            internalVelocity,
            wishDirection,
            PHYSICS.AirStrafeAcceleration,
            PHYSICS.AirStrafeAcceleration,
            dt
        )

    return predicted,
        wishDirection
end

local function PredictPath()

    local character =
        LocalPlayer.Character

    if not character then
        return {}
    end

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not root
        or not humanoid
    then
        return {}
    end

    local camera =
        workspace.CurrentCamera

    if not camera then
        return {}
    end

    local position =
        root.Position

    local velocity =
        Flat(
            root.AssemblyLinearVelocity
        )

    local internalVelocity =
        velocity
        * PHYSICS.Scale

    local startsGrounded =
        IsGrounded(
            root,
            humanoid
        )

    if internalVelocity.Magnitude
        < 10
    then

        internalVelocity =
            SafeUnit(
                Flat(
                    camera.CFrame.LookVector
                ),
                Vector3.new(
                    0,
                    0,
                    -1
                )
            )
            * PHYSICS.Speed

    end

    -- Reproduce the horizontal jump-speed adjustment from test2.
    -- The game stores velocity in internal units and applies
    -- JumpSpeedMultiplier only when the current speed is below
    -- the view-aligned sprint cap.
    if startsGrounded
        and internalVelocity.Magnitude > 0.001
    then

        local velocityDirection =
            internalVelocity.Unit

        local lookDirection =
            SafeUnit(
                Flat(
                    root.CFrame.LookVector
                ),
                velocityDirection
            )

        local alignment =
            math.clamp(
                lookDirection:Dot(
                    velocityDirection
                ),
                -1,
                1
            )

        local jumpSpeedLimit =
            PHYSICS.Speed
            * PHYSICS.SprintCap
            * PHYSICS.JumpSpeedMultiplier
            * alignment
            * alignment

        local boostedSpeed =
            math.min(
                internalVelocity.Magnitude
                * PHYSICS.JumpSpeedMultiplier,
                jumpSpeedLimit
            )

        if boostedSpeed
            > internalVelocity.Magnitude
        then

            internalVelocity =
                velocityDirection
                * boostedSpeed
        end
    end

    local gravity =
        workspace.Gravity

    local vertical

    if startsGrounded then
        vertical =
            math.sqrt(
                2
                * gravity
                * PHYSICS.JumpHeight
            )
    else
        vertical =
            root.AssemblyLinearVelocity.Y
    end

    local points = {
        position
    }

    local travelled = 0

    local nextPoint =
        CONFIG.PathPointSpacing

    local side =
        currentSide

    -- Preserve the real root's orientation while moving the
    -- prediction's collision volume to its simulated position.
    local rootOrientation =
        CFrame.fromMatrix(
            Vector3.new(),
            root.CFrame.RightVector,
            root.CFrame.UpVector,
            -root.CFrame.LookVector
        )

    for step = 1,
        CONFIG.PredictionMaxSteps
    do

        if ENV.StrafeControllerStop then
            return points
        end

        local predictionDt =
            CONFIG.PredictionTick

        local nextVelocity,
        wishDirection =
            GetPredictionAirAction(
                internalVelocity,
                side,
                predictionDt
            )

        internalVelocity =
            nextVelocity

        vertical =
            vertical
            - gravity
            * predictionDt

        local horizontal =
            internalVelocity
            / PHYSICS.Scale

        local frameVelocity =
            horizontal
            + Vector3.new(
                0,
                vertical,
                0
            )

        local newPosition =
            position
            + frameVelocity
            * predictionDt

        -- World collision checks are deliberately throttled.
        -- The old version performed many Blockcasts for every
        -- simulated frame and was the main FPS killer.
        if step
            % CONFIG.PredictionCollisionEvery
            == 0
        then

            local movement =
                Flat(
                    newPosition
                    - position
                )

            if movement.Magnitude > 0 then

                local castCFrame =
                    CFrame.new(
                        position
                    )
                    * rootOrientation

                local wall =
                    WallBlockcastAt(
                        root,
                        castCFrame,
                        movement.Unit,
                        movement.Magnitude
                        + 1
                    )

                if wall then

                    local normal =
                        Flat(
                            wall.Normal
                        )

                    if normal.Magnitude
                        > 0.001
                    then

                        normal =
                            normal.Unit

                        local tangent =
                            Vector3.new(
                                -normal.Z,
                                0,
                                normal.X
                            )

                        local leftClear =
                            GetClearance(
                                root,
                                tangent,
                                8,
                                castCFrame
                            )

                        local rightClear =
                            GetClearance(
                                root,
                                -tangent,
                                8,
                                castCFrame
                            )

                        local escape

                        if leftClear
                            > rightClear
                        then
                            escape = tangent
                        else
                            escape = -tangent
                        end

                        internalVelocity =
                            Accelerate(
                                internalVelocity,
                                escape,
                                PHYSICS.AirStrafeAcceleration,
                                PHYSICS.AirStrafeAcceleration,
                                predictionDt
                            )

                        wishDirection =
                            escape
                    end
                end
            end
        end

        -- Terrain is also sampled less often. Between samples
        -- the prediction is simply integrated forward.
        if step
            % CONFIG.PredictionGroundEvery
            == 0
        then

            local ground =
                GroundAt(
                    newPosition
                )

            if
                ground
                and IsWalkable(
                    ground.Normal
                )
            then

                local floorY =
                    ground.Position.Y
                    + 2

                if newPosition.Y
                    <= floorY
                then

                    newPosition =
                        Vector3.new(
                            newPosition.X,
                            floorY,
                            newPosition.Z
                        )

                    internalVelocity =
                        ApplyFriction(
                            internalVelocity,
                            predictionDt,
                            1
                        )

                    vertical =
                        math.sqrt(
                            2
                            * gravity
                            * PHYSICS.JumpHeight
                        )

                    side =
                        -side
                end
            end
        end

        local delta =
            Flat(
                newPosition
                - position
            )

        local stepDistance =
            delta.Magnitude

        local oldDistance =
            travelled

        travelled =
            travelled
            + stepDistance

        if stepDistance > 0 then

            while
                nextPoint <= travelled
                and nextPoint
                    <= CONFIG.PathDistance
            do

                local alpha =
                    (
                        nextPoint
                        - oldDistance
                    )
                    / stepDistance

                alpha =
                    math.clamp(
                        alpha,
                        0,
                        1
                    )

                table.insert(
                    points,
                    position:Lerp(
                        newPosition,
                        alpha
                    )
                )

                nextPoint =
                    nextPoint
                    + CONFIG.PathPointSpacing
            end
        end

        position =
            newPosition

        if travelled
            >= CONFIG.PathDistance
        then
            break
        end
    end

    return points
end

