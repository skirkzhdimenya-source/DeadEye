local VirtualInputManager = nil

pcall(function()
    VirtualInputManager = game:GetService("VirtualInputManager")
end)

local KEY_W = Enum.KeyCode.W
local KEY_A = Enum.KeyCode.A
local KEY_D = Enum.KeyCode.D
local KEY_SPACE = Enum.KeyCode.Space

local function SendKey(keyCode, pressed)
    if not VirtualInputManager then
        return false
    end

    return pcall(function()
        VirtualInputManager:SendKeyEvent(
            pressed,
            keyCode,
            false,
            game
        )
    end)
end

local function SetKey(name, keyCode, value)
    if keys[name] == value then
        return
    end

    keys[name] = value
    SendKey(keyCode, value)
end

local function ReleaseStrafe()
    SetKey("A", KEY_A, false)
    SetKey("D", KEY_D, false)
end

local function ApplyStrafe()
    if currentSide > 0 then
        SetKey("D", KEY_D, true)
        SetKey("A", KEY_A, false)
    else
        SetKey("A", KEY_A, true)
        SetKey("D", KEY_D, false)
    end
end

local function ReleaseAllKeys()
    SetKey("W", KEY_W, false)
    ReleaseStrafe()
    SetKey("Space", KEY_SPACE, false)
end

--==============================================================--
-- JUMP
--==============================================================--

local function DoJump()
    if cleanupDone then
        return
    end

    local now = os.clock()

    if now - lastJump < CONFIG.JumpCooldown then
        return
    end

    lastJump = now

    local character = LocalPlayer.Character
    if not character then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return
    end

    -- Roblox state as a second path.
    pcall(function()
        humanoid.Jump = true
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end)

    -- Game input path.
    SetKey("Space", KEY_SPACE, true)

    task.delay(CONFIG.JumpHoldTime, function()
        if cleanupDone then
            return
        end

        SetKey("Space", KEY_SPACE, false)
    end)
end

--==============================================================--
-- VECTOR HELPERS
--==============================================================--

local function Flat(v)
    return Vector3.new(v.X, 0, v.Z)
end

local function SafeUnit(v, fallback)
    if v.Magnitude > 0.00001 then
        return v.Unit
    end

    return fallback
end

local function RotateY(v, radians)
    local c = math.cos(radians)
    local s = math.sin(radians)

    return Vector3.new(
        v.X * c - v.Z * s,
        0,
        v.X * s + v.Z * c
    )
end

local function YawFromDirection(v)
    v = SafeUnit(
        Flat(v),
        Vector3.new(0, 0, -1)
    )

    return math.atan2(
        -v.X,
        -v.Z
    )
end

local function DirectionFromYaw(yaw)
    return Vector3.new(
        -math.sin(yaw),
        0,
        -math.cos(yaw)
    )
end

local function RightFromYaw(yaw)
    return Vector3.new(
        math.cos(yaw),
        0,
        -math.sin(yaw)
    )
end

local function AngleDifference(a, b)
    return math.atan2(
        math.sin(b - a),
        math.cos(b - a)
    )
end

