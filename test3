--==============================================================--
-- MAIN CONTROL
--==============================================================--

local function ControllerUpdate()

    if ENV.StrafeControllerStop then
        Cleanup()
        return
    end

    if not ENV.StrafeControllerEnabled then
        return
    end

    local now =
        os.clock()

    if now - lastTick
        < CONFIG.Tick
    then
        return
    end

    lastTick =
        now

    local character =
        LocalPlayer.Character

    if not character then
        ReleaseAllKeys()
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not humanoid
        or not root
    then

        ReleaseAllKeys()

        return
    end

    UpdateRayFilter()

    --==========================================================--
    -- VELOCITY
    --==========================================================--

    local velocity =
        Flat(
            root.AssemblyLinearVelocity
        )

    local speed =
        velocity.Magnitude

    local camera =
        workspace.CurrentCamera

    if not camera then
        return
    end

    local cameraForward =
        SafeUnit(
            Flat(
                camera.CFrame.LookVector
            ),
            Vector3.new(
                0,
                0,
                -1
            )
        )

    local movementDirection

    if speed > 0.5 then
        movementDirection =
            velocity.Unit
    else
        movementDirection =
            cameraForward
    end

    --==========================================================--
    -- GROUNDED
    --==========================================================--

    local grounded =
        IsGrounded(
            root,
            humanoid
        )

    --==========================================================--
    -- GROUND
    --==========================================================--

    if grounded then

        -- forward movement
        SetKey(
            "W",
            KEY_W,
            true
        )

        ReleaseStrafe()

        --======================================================--
        -- TERRAIN / WALL
        --======================================================--

        local groundAction =
            GetBestGroundDirection(
                root,
                velocity,
                cameraForward
            )

        local targetDirection =
            groundAction.Direction

        local wallEscape =
            GetWallEscapeDirection(
                root,
                velocity
            )

        if wallEscape then
            targetDirection =
                wallEscape
        end

        --======================================================--
        -- CAMERA
        --======================================================--

        SetCameraYaw(
            YawFromDirection(
                targetDirection
            )
        )

        --======================================================--
        -- JUMP CONDITIONS
        --======================================================--

        local terrainJump =
            TerrainNeedsJump(
                root,
                targetDirection
            )

        local wall =
            GetWallThreat(
                root,
                targetDirection
            )

        if CONFIG.AutoBhop then

            DoJump()

        elseif terrainJump
            or wall
        then

            DoJump()

        end

    else

        --======================================================--
        -- AIR
        --======================================================--

        -- Keep W held.
        -- The game's Air code removes its forward component.
        SetKey(
            "W",
            KEY_W,
            true
        )

        --======================================================--
        -- CHOOSE AIR ACTION
        --======================================================--

        local action =
            GetBestAirAction(
                root,
                velocity
            )

        if action then

            currentSide =
                action.Side

            --==================================================--
            -- WALL OVERRIDE
            --==================================================--

            local escape =
                GetWallEscapeDirection(
                    root,
                    velocity
                )

            if escape then

                -- Try to keep the chosen A/D side,
                -- but point its camera toward the escape.
                local escapeAction =
                    {
                        WishDir = escape,
                        Side =
                            currentSide,
                    }

                if currentSide > 0 then

                    escapeAction.CameraYaw =
                        math.atan2(
                            -escape.Z,
                            escape.X
                        )

                else

                    escapeAction.CameraYaw =
                        math.atan2(
                            escape.Z,
                            -escape.X
                        )

                end

                SetCameraYaw(
                    escapeAction.CameraYaw
                )

            else

                SetCameraYaw(
                    action.CameraYaw
                )

            end

            ApplyStrafe()

        else

            ApplyStrafe()

        end

    end

    --==========================================================--
    -- LANDING
    --==========================================================--

    if grounded
        and not wasGrounded
    then

        currentSide =
            -currentSide

        if CONFIG.AutoBhop then
            DoJump()
        end

    end

    wasGrounded =
        grounded

    --==========================================================--
    -- PATH
    --==========================================================--

    if CONFIG.DrawPath then

        if now - lastPathUpdate
            >= 0.05
        then

            lastPathUpdate =
                now

            local points =
                PredictPath()

            DrawPath(
                points
            )

        end

    else

        ClearLines()

    end

end

