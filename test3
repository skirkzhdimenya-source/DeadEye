local Lines = {}

for i = 1, 180 do

    local line =
        Drawing.new("Line")

    line.Visible = false
    line.Thickness = 1
    line.Transparency = 0.55
    line.Color =
        Color3.fromRGB(
            205,
            205,
            205
        )
    line.ZIndex = 1

    Lines[i] =
        line
end

local function ClearLines()

    for _, line in ipairs(
        Lines
    ) do

        line.Visible = false

    end
end

local function DrawPath(
    points
)

    ClearLines()

    if not CONFIG.DrawPath then
        return
    end

    if #points < 2 then
        return
    end

    local camera =
        workspace.CurrentCamera

    if not camera then
        return
    end

    local index = 1

    for i = 1, #points - 1 do

        if index > #Lines then
            break
        end

        local screen1 =
            camera:WorldToViewportPoint(
                points[i]
            )

        local screen2 =
            camera:WorldToViewportPoint(
                points[i + 1]
            )

        local line =
            Lines[index]

        line.From =
            Vector2.new(
                screen1.X,
                screen1.Y
            )

        line.To =
            Vector2.new(
                screen2.X,
                screen2.Y
            )

        line.Visible = true

        index =
            index + 1
    end
end

