local function CleanupInternal()

    if cleanupDone then
        return
    end

    cleanupDone =
        true

    ENV.StrafeControllerStop =
        true

    ENV.StrafeControllerEnabled =
        false

    ReleaseAllKeys()

    ClearLines()

    pcall(function()
        RunService:UnbindFromRenderStep(
            "DeadEyeAutoStrafe"
        )
    end)

    if InputConnection then
        InputConnection:Disconnect()
        InputConnection = nil
    end

    for _, line in ipairs(
        Lines
    ) do

        pcall(function()
            line:Remove()
        end)

    end

    Lines = {}

    if ScreenGui then
        ScreenGui:Destroy()
    end

    ENV.__DeadEyeStrafeControllerCleanup =
        nil

end

Cleanup = CleanupInternal

ENV.__DeadEyeStrafeControllerCleanup =
    CleanupInternal

Close.MouseButton1Click:Connect(
    CleanupInternal
)

