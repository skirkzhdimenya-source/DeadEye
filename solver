local function removeTargetMarker()
    if TargetMarker then
        pcall(
            function()
                TargetMarker:Destroy()
            end
        )

        TargetMarker = nil
    end
end

local function createTargetMarker(position)
    removeTargetMarker()

    local marker =
        Instance.new("Part")

    marker.Name =
        "ATB_Target"

    marker.Shape =
        Enum.PartType.Ball

    marker.Size =
        Vector3.new(
            1.2,
            1.2,
            1.2
        )

    marker.Anchored = true

    marker.CanCollide = false
    marker.CanTouch = false
    marker.CanQuery = false

    marker.Material =
        Enum.Material.Neon

    marker.Transparency = 0.2

    marker.Position =
        position

    marker.Parent =
        workspace

    TargetMarker =
        marker
end

--==============================================================--
-- PICK TARGET
--==============================================================--

local function pickTarget()
    Camera =
        workspace.CurrentCamera

    if not Camera then
        return nil
    end

    if not Root then
        updateCharacter()
    end

    if not Root then
        return nil
    end

    local mousePosition =
        UserInputService:GetMouseLocation()

    local ray =
        Camera:ViewportPointToRay(
            mousePosition.X,
            mousePosition.Y
        )

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances = {
        Character
    }

    local result =
        workspace:Raycast(
            ray.Origin,
            ray.Direction * 10000,
            params
        )

    if not result then
        return nil
    end

    return result.Position
end

--==============================================================--
-- CAMERA ALIGNMENT
--==============================================================--

local function setMovementInput(value)
    if not MovementTable then
        return false
    end

    local current =
        rawget(
            MovementTable,
            "Movement"
        )

    local currentType =
        typeof(current)

    local output = value

    if currentType == "Vector2" then
        output =
            Vector2.new(
                value,
                0
            )

    elseif currentType == "Vector3" then
        output =
            Vector3.new(
                value,
                0,
                0
            )

    elseif currentType == "number" then
        output = value

    else
        warn(
            "[ATB Solver] Unknown Movement type:",
            currentType,
            "value =",
            tostring(current)
        )

        return false
    end

    local ok, err =
        pcall(
            function()
                MovementTable.Movement =
                    output
            end
        )

    if not ok then
        warn(
            "[ATB Solver] Failed to set Movement:",
            err
        )

        return false
    end

    return true
end

local function updateCameraTowardYaw(targetYaw)
    if not MovementTable then
        return
    end

    if not Root then
        return
    end

    if targetYaw == nil then
        return
    end

    local currentYaw =
        cameraToYaw()

    local error =
        angleDifference(
            targetYaw,
            currentYaw
        )

    local targetInput =
        error
        / math.rad(
            DEG_PER_INPUT
        )

    targetInput =
        clamp(
            targetInput,
            -MAX_CAMERA_INPUT,
            MAX_CAMERA_INPUT
        )

    local now =
        tick()

    local dt =
        LastCameraUpdate
        and clamp(
            now - LastCameraUpdate,
            1 / 240,
            1 / 20
        )
        or (1 / 60)

    LastCameraUpdate =
        now

    local alpha =
        1
        - math.exp(
            -CAMERA_SMOOTH_SPEED
            * dt
        )

    SmoothedCameraInput =
        SmoothedCameraInput
        + (
            targetInput
            - SmoothedCameraInput
        )
        * alpha

    setMovementInput(
        SmoothedCameraInput
    )
end


--==============================================================--
-- REAL JUMP
--==============================================================--

local function executeJump()
    if not GameCharacter then
        updateGameCharacter()
    end

    if not GameCharacter
        or not GameCharacter.Movement
    then
        return false
    end

    local ok, err =
        pcall(
            function()
                GameCharacter.Movement:
                    Jump(
                        nil,
                        true
                    )
            end
        )

    if not ok then
        warn(
            "[ATB Solver] Jump failed:",
            err
        )

        return false
    end

    return true
end

--==============================================================--
-- APPLY A / W / D
--==============================================================--

local function applyAction(action)
    if action == -1 then
        -- A
        DesiredMoveVector =
            Vector3.new(
                -1,
                0,
                -1
            ).Unit

    elseif action == 1 then
        -- D
        DesiredMoveVector =
            Vector3.new(
                1,
                0,
                -1
            ).Unit

    else
        -- N: не подаём lateral input в воздухе.
        DesiredMoveVector =
            Vector3.zero
    end
end

