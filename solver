--==============================================================--
-- START SOLVER
--==============================================================--

local function getLiveSteering()
    if not Root then
        return 0, nil, 0, math.huge
    end

    if not TargetPosition then
        return 0, nil, 0, math.huge
    end

    local delta =
        flat(
            TargetPosition
            - Root.Position
        )

    local distance =
        delta.Magnitude

    if distance < 0.001 then
        LiveSteerAction = 0

        return
            0,
            vectorToYaw(
                flat(
                    Root.CFrame.LookVector
                )
            ),
            0,
            distance
    end

    local targetDirection =
        delta.Unit

    local velocity =
        flat(
            getInternalVelocity()
        )

    if velocity.Magnitude < 0.001 then
        velocity =
            flat(
                Root.AssemblyLinearVelocity
            )
            * VELOCITY_SCALE
    end

    if velocity.Magnitude < 0.001 then
        -- Нет горизонтальной скорости: смотрим прямо на B
        -- и не пытаемся закручивать скорость из нуля.
        LiveSteerAction = 0

        return
            0,
            vectorToYaw(
                targetDirection
            ),
            180,
            distance
    end

    local velocityDirection =
        velocity.Unit

    local headingDot =
        clamp(
            velocityDirection:Dot(
                targetDirection
            ),
            -1,
            1
        )

    local headingAngle =
        math.deg(
            math.acos(
                headingDot
            )
        )

    local cameraRight =
        rightPerpendicular(
            velocityDirection
        )

    local targetSide =
        targetDirection:Dot(
            cameraRight
        )

    -- Гистерезис:
    -- не дёргаем A <-> D на границе курса.
    if LiveSteerAction == 0 then
        if headingAngle >= STEER_REENGAGE_DEG then
            if targetSide >= 0 then
                LiveSteerAction = 1
            else
                LiveSteerAction = -1
            end
        end

    else
        if headingAngle <= STEER_RELEASE_DEG then
            LiveSteerAction = 0

        elseif LiveSteerAction == 1
            and targetSide < -STEER_SIDE_SWITCH_DOT
        then
            LiveSteerAction = -1

        elseif LiveSteerAction == -1
            and targetSide > STEER_SIDE_SWITCH_DOT
        then
            LiveSteerAction = 1
        end
    end

    local targetYaw

    if LiveSteerAction == 0 then
        -- Курс совпал с B: камера смотрит на B, N сохраняет
        -- текущую высокую скорость по прямой.
        targetYaw =
            vectorToYaw(
                targetDirection
            )
    else
        -- A/D должны видеть CameraRight перпендикулярным
        -- текущей velocity для максимального air-strafe.
        targetYaw =
            vectorToYaw(
                velocityDirection
            )
    end

    return
        LiveSteerAction,
        targetYaw,
        headingAngle,
        distance
end

local function isGrounded()
    if not Humanoid or not Root then
        return false
    end

    local state =
        Humanoid:GetState()

    if state ==
        Enum.HumanoidStateType.Landed
    then
        return true
    end

    if Humanoid.FloorMaterial
        ~= Enum.Material.Air
    then
        return true
    end

    -- Дополнительная физическая проверка:
    -- действительно ли под root находится поверхность
    -- примерно на уровне ног.
    local result =
        getGroundRay()

    if not result then
        return false
    end

    local hipHeight =
        Humanoid.HipHeight

    local distance =
        (Root.Position.Y
            - result.Position.Y)

    return distance
        <= hipHeight + 0.35
end

local function waitForGrounded(timeout)
    local deadline =
        tick()
        + (timeout or 0.75)

    while
        not ATB_ENV.ATBSolverStop
        and not Destroyed
        and tick() < deadline
    do
        updateCharacter()

        if isGrounded() then
            return true
        end

        RunService.RenderStepped:Wait()
    end

    return isGrounded()
end

local function startSolver()
    if Running then
        return
    end

    if Destroyed then
        return
    end

    ATB_ENV.ATBSolverStop = false

    LastRuntimeError = nil
    ExecutionSamples = {}

    if JumpCount == 1 then
        LiveSteerAction = 0
        LastExecutionPosition = nil
        SmoothedCameraInput = 0
        LastCameraUpdate = tick()
    end

    if MovementTable then
        local initialMovement =
            rawget(
                MovementTable,
                "Movement"
            )

        if typeof(initialMovement) == "Vector2" then
            SmoothedCameraInput =
                initialMovement.X
        elseif typeof(initialMovement) == "number" then
            SmoothedCameraInput =
                initialMovement
        end
    end

    updateCharacter()
    updateGameCharacter()

    if not Root
        or not Humanoid
    then
        warn(
            "[ATB Solver] Character not ready"
        )

        return
    end

    if not TargetPosition then
        warn(
            "[ATB Solver] Target not selected. Press F6."
        )

        return
    end

    if not MovementTable then
        MovementTable =
            findMovementTable()

        if MovementTable then
            OriginalMovementValue =
                MovementTable.Movement

            print(
                "[ATB Solver] Movement type =",
                typeof(OriginalMovementValue),
                "initial value =",
                tostring(OriginalMovementValue)
            )
        end
    end

    if not MovementTable then
        warn(
            "[ATB Solver] Movement table not found"
        )

        return
    end

    if not setupControlModule() then
        return
    end

    -- После автоматического перехода ждём именно физический
    -- контакт с землёй. Это НЕ искусственная задержка:
    -- новый Jump() вызывается на первом grounded-кадре.
    if JumpCount > 0 then
        local grounded =
            waitForGrounded(0.75)

        if not grounded then
            warn(
                "[ATB Solver] Could not confirm grounded state for next jump"
            )

            Running = false
            ATB_ENV.ATBSolverActive = false
            return
        end
    end

    JumpCount =
        JumpCount + 1

    LastExecutionPosition = nil

    PlanIndex = 1

    Running = true

    ATB_ENV.ATBSolverActive = true

    print(
        "=================================================="
    )

    print(
        "[ATB Solver] JUMP #",
        JumpCount,
        "/",
        MAX_AUTO_JUMPS
    )

    print(
        "========== A -> B SOLVER START ==================="
    )

    print(
        "=================================================="
    )

    print(
        "TARGET =",
        TargetPosition
    )

    --==========================================================--
    -- PRE-ALIGN ONLY FOR THE FIRST JUMP
    --
    -- После первого приземления нельзя обнулять input и
    -- заново крутить камеру перед каждым прыжком: это режет
    -- горизонтальную скорость на земле.
    --==========================================================--

    if JumpCount == 1 then
        local alignStart =
            tick()

        while
            not ATB_ENV.ATBSolverStop
            and tick() - alignStart < PRE_ALIGN_TIME
        do
            if not Root then
                break
            end

            DesiredMoveVector =
                Vector3.zero

            local _, preAlignYaw =
                getLiveSteering()

            updateCameraTowardYaw(
                preAlignYaw
            )

            local velocity =
                flat(
                    getInternalVelocity()
                )

            if velocity.Magnitude > 0.001 then
                local error =
                    math.deg(
                        math.abs(
                            angleDifference(
                                vectorToYaw(
                                    velocity
                                ),
                                cameraToYaw()
                            )
                        )
                    )

                if error < 0.2 then
                    break
                end
            end

            RunService.RenderStepped:Wait()
        end
    end

    if ATB_ENV.ATBSolverStop then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    --==========================================================--
    -- PRIME JUMP WITH REAL FORWARD INPUT
    --
    -- Раньше перед Jump() DesiredMoveVector был zero.
    -- Поэтому Jump() иногда стартовал строго на месте, а
    -- последующее ожидание горизонтальной скорости ничего
    -- не могло создать.
    --
    -- Сначала даём реальный W-ввод на один кадр, затем Jump().
    --==========================================================--

    local primeAction,
        primeYaw =
        getLiveSteering()

    if primeAction == -1 then
        DesiredMoveVector =
            Vector3.new(
                -1,
                0,
                -1
            ).Unit

    elseif primeAction == 1 then
        DesiredMoveVector =
            Vector3.new(
                1,
                0,
                -1
            ).Unit

    else
        -- На точном курсе B lateral input не нужен.
        -- На первом прыжке оставляем W на один кадр для старта.
        if JumpCount == 1 then
            DesiredMoveVector =
                Vector3.new(
                    0,
                    0,
                    -1
                )
        else
            DesiredMoveVector =
                Vector3.zero
        end
    end

    if JumpCount == 1 then
        if primeYaw then
            updateCameraTowardYaw(
                primeYaw
            )
        end

        -- Только первый Jump требует отдельного кадра,
        -- чтобы первичный W-ввод попал в native camera/movement.
        RunService.RenderStepped:Wait()
    end

    if ATB_ENV.ATBSolverStop then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    local jumpSuccess =
        executeJump()

    if not jumpSuccess then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    -- Ждём первый физический кадр после Jump().
    RunService.Heartbeat:Wait()

    if ATB_ENV.ATBSolverStop then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    updateCharacter()
    updateGameCharacter()

    if not Root then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    -- Важный момент:
    -- DataRegistry.Velocity обновляется с задержкой, поэтому для
    -- начальной скорости после Jump() используем фактический
    -- AssemblyLinearVelocity и применяем подтверждённый scale 90.
    local rawStartVelocity =
        Root.AssemblyLinearVelocity

    local startVelocity =
        flat(
            rawStartVelocity
            * VELOCITY_SCALE
        )

    local startPosition =
        Root.Position

    local verticalVelocity =
        rawStartVelocity.Y

    print(
        "[ATB Solver] RAW POST-JUMP VELOCITY =",
        rawStartVelocity
    )

    print(
        "[ATB Solver] START VELOCITY FROM RAW =",
        startVelocity
    )

    local groundY =
        getRootGroundY()

    if not groundY then
        groundY =
            startPosition.Y
            - (
                Humanoid
                and Humanoid.HipHeight
                or 0
            )
    end

    local timeToLand =
        getDescendingTime(
            startPosition.Y,
            verticalVelocity,
            groundY
        )

    if not timeToLand then
        timeToLand =
            math.max(
                0.1,
                2
                    * verticalVelocity
                    / GRAVITY
            )
    end

    print(
        "START POSITION =",
        startPosition
    )

    print(
        "START VELOCITY INTERNAL =",
        startVelocity
    )

    if startVelocity.Magnitude < 0.001 then
        warn(
            "[ATB Solver] Horizontal jump velocity was not observed before planning"
        )
    end

    print(
        "START H SPEED INTERNAL =",
        startVelocity.Magnitude
    )

    print(
        "VERTICAL VELOCITY =",
        verticalVelocity
    )

    print(
        "TIME TO LAND =",
        timeToLand
    )

    --==========================================================--
    -- BUILD PLAN
    --==========================================================--

    --==========================================================--
    -- LIVE SOLVER
    --
    -- В боевом цикле НЕ строим beam-plan. Он создавал
    -- лишний freeze на десятки миллисекунд после каждого Jump.
    -- Steering принимается по фактической velocity/цели каждый кадр.
    --==========================================================--

    local buildDuration =
        0

    local plan = {
        actions = {},
        predictedPosition = TargetPosition,
        predictedVelocity = startVelocity,
        predictedDistance = 0,
        predictedApproachDot = 0,
        steps = 0,
        totalTime = timeToLand
    }

    local actionText =
        "LIVE TARGET STEERING"

    print(
        "[ATB Solver] LIVE STEERING ENABLED"
    )

    --==========================================================--
    -- EXECUTION
    --==========================================================--

    local executionStart =
        tick()

    local lastLogAction = nil
    local lastLogAngle = nil

    while
        not ATB_ENV.ATBSolverStop
        and Root
        and Root.Parent
        and Humanoid
        and Humanoid.Health > 0
    do
        PlanIndex =
            math.floor(
                (
                    tick()
                    - executionStart
                )
                / SIM_DT
            ) + 1

        local action,
            targetYaw,
            headingAngle,
            targetDistance =
            getLiveSteering()

        if action == -1 then
            DesiredMoveVector =
                Vector3.new(
                    -1,
                    0,
                    -1
                ).Unit

        elseif action == 1 then
            DesiredMoveVector =
                Vector3.new(
                    1,
                    0,
                    -1
                ).Unit

        else
            DesiredMoveVector =
                Vector3.zero
        end

        updateCameraTowardYaw(
            targetYaw
        )

        local currentPosition =
            Root.Position

        --======================================================--
        -- TARGET TOUCH CHECK
        --
        -- Нужна именно точка касания ногами:
        -- root.Y должен быть примерно на HipHeight выше B.
        --======================================================--

        local targetGroundY =
            TargetPosition.Y
            + (
                Humanoid
                and Humanoid.HipHeight
                or 0
            )

        local descending =
            Root.AssemblyLinearVelocity.Y
            <= 0

        local nearTouchHeight =
            math.abs(
                currentPosition.Y
                - targetGroundY
            )
            <= 1.25

        -- Дополнительная проверка отрезка движения:
        -- на большой скорости можно пролететь через небольшой
        -- радиус между двумя RenderStepped-кадрами.
        local segmentHit = false

        if LastExecutionPosition then
            local segment =
                currentPosition
                - LastExecutionPosition

            local lengthSquared =
                flat(segment).Magnitude
                * flat(segment).Magnitude

            if lengthSquared > 0.000001 then
                local fromTarget =
                    flat(
                        TargetPosition
                        - LastExecutionPosition
                    )

                local projection =
                    fromTarget:Dot(
                        flat(segment)
                    )
                    / lengthSquared

                projection =
                    clamp(
                        projection,
                        0,
                        1
                    )

                local closest =
                    LastExecutionPosition
                    + segment * projection

                local segmentDistance =
                    flat(
                        TargetPosition
                        - closest
                    ).Magnitude

                if segmentDistance
                    <= TARGET_TOUCH_DISTANCE
                then
                    segmentHit = true
                end
            end
        end

        LastExecutionPosition =
            currentPosition

        if targetDistance
            <= TARGET_TOUCH_DISTANCE
            and descending
            and nearTouchHeight
        then
            print(
                "[ATB Solver] TOUCHDOWN TARGET HIT.",
                "DISTANCE =",
                targetDistance,
                "HEADING =",
                headingAngle
            )

            break
        end

        if segmentHit
            and descending
            and nearTouchHeight
        then
            print(
                "[ATB Solver] TARGET SEGMENT HIT.",
                "DISTANCE =",
                targetDistance,
                "HEADING =",
                headingAngle
            )

            break
        end

        if action ~= lastLogAction
            or (
                lastLogAngle == nil
                or math.abs(
                    headingAngle
                    - lastLogAngle
                ) > 5
            )
        then
            print(
                "[ATB Solver] STEER =",
                action == -1
                    and "A"
                    or action == 1
                    and "D"
                    or "N",
                "HEADING =",
                headingAngle,
                "DISTANCE =",
                targetDistance
            )

            lastLogAction =
                action

            lastLogAngle =
                headingAngle
        end

        local state =
            Humanoid:GetState()

        if state ==
            Enum.HumanoidStateType.Landed
            or state ==
                Enum.HumanoidStateType.Running
            or state ==
                Enum.HumanoidStateType.RunningNoPhysics
        then
            break
        end

        RunService.RenderStepped:Wait()
    end

    --==========================================================--
    -- RESULT
    --==========================================================--

    local endPosition =
        Root
        and Root.Position
        or Vector3.zero

    local actualError =
        flat(
            TargetPosition
            - endPosition
        ).Magnitude

    local resultReport =
        table.concat(
            {
                "",
                "==================================================",
                "========== A -> B SOLVER END =====================",
                "JUMP = " .. tostring(JumpCount),
                "==================================================",

                "TARGET = "
                    .. tostring(
                        TargetPosition
                    ),

                "START = "
                    .. tostring(
                        startPosition
                    ),

                "END = "
                    .. tostring(
                        endPosition
                    ),

                "ACTUAL ERROR = "
                    .. tostring(
                        actualError
                    ),

                "PLAN STEPS = "
                    .. tostring(
                        #ActivePlan
                    ),

                "USED STEPS = "
                    .. tostring(
                        PlanIndex
                    ),

                "MODE = LIVE TARGET STEERING",

                "PREDICTED ERROR = live steering",

                "PREDICTED APPROACH DOT = live steering",

                "",
                "START VELOCITY INTERNAL = "
                    .. tostring(
                        startVelocity
                    ),

                "START H SPEED INTERNAL = "
                    .. tostring(
                        startVelocity.Magnitude
                    ),

                "VERTICAL VELOCITY = "
                    .. tostring(
                        verticalVelocity
                    ),

                "TIME TO LAND = "
                    .. tostring(
                        timeToLand
                    ),

                "BUILD PLAN TIME = "
                    .. tostring(
                        buildDuration
                    ),

                "PLAN = "
                    .. tostring(
                        actionText
                    ),

                "",
                "EXECUTION SAMPLES = "
                    .. (
                        #ExecutionSamples > 0
                        and table.concat(
                            ExecutionSamples,
                            "\n"
                        )
                        or "none"
                    ),

                "",
                "RUNTIME ERROR = "
                    .. tostring(
                        LastRuntimeError
                            or "none"
                    ),

                "FINAL MOVEMENT TYPE = "
                    .. tostring(
                        MovementTable
                            and typeof(
                                MovementTable.Movement
                            )
                            or "nil"
                    ),

                "FINAL MOVEMENT VALUE = "
                    .. tostring(
                        MovementTable
                            and MovementTable.Movement
                            or "nil"
                    ),

                "FINAL DESIRED MOVE = "
                    .. tostring(
                        DesiredMoveVector
                    ),

                "CONTROL HOOK INSTALLED = "
                    .. tostring(
                        ControlHookInstalled
                    ),

                "=================================================="
            },
            "\n"
        )

    print(
        resultReport
    )

    print(
        "[ATB Solver] FINAL REPORT COPIED"
    )

    copyReport(
        resultReport
    )

    --==========================================================--
    -- AUTO NEXT JUMP
    --==========================================================--

    if not ATB_ENV.ATBSolverStop
        and actualError > TARGET_REACHED_DISTANCE
        and JumpCount < MAX_AUTO_JUMPS
    then
        print(
            "[ATB Solver] TARGET NOT REACHED.",
            "DISTANCE =",
            actualError,
            "STARTING NEXT JUMP..."
        )

        Running = false

        ATB_ENV.ATBSolverActive =
            false

        -- Не обнуляем DesiredMoveVector / Movement между
        -- прыжками: персонаж должен сохранить input и скорость
        -- до следующего Jump().
        task.defer(
            function()
                if ATB_ENV.ATBSolverStop
                    or Destroyed
                then
                    return
                end

                if Running then
                    return
                end

                startSolver()
            end
        )

        return
    end

    if actualError <= TARGET_REACHED_DISTANCE then
        print(
            "[ATB Solver] TARGET REACHED.",
            "DISTANCE =",
            actualError
        )

    elseif JumpCount >= MAX_AUTO_JUMPS then
        warn(
            "[ATB Solver] MAX AUTO JUMPS REACHED.",
            "DISTANCE =",
            actualError
        )
    end

    Running = false

    ATB_ENV.ATBSolverActive =
        false

    DesiredMoveVector =
        Vector3.zero

    SmoothedCameraInput = 0
    LastCameraUpdate = nil

    if MovementTable then
        pcall(
            function()
                MovementTable.Movement = 0
            end
        )
    end
end

--==============================================================--
-- STOP
--==============================================================--

local function stopSolver()
    if Destroyed then
        return
    end

    ATB_ENV.ATBSolverStop = true

    Running = false

    ATB_ENV.ATBSolverActive = false

    DesiredMoveVector =
        Vector3.zero

    if MovementTable then
        pcall(
            function()
                MovementTable.Movement = 0
            end
        )
    end

    print(
        "[ATB Solver] STOP"
    )
end

--==============================================================--
-- INPUT
--==============================================================--

connect(
    UserInputService.InputBegan,
    function(input, gameProcessed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end

        print(
            "[ATB Solver] KEY =",
            input.KeyCode,
            "PROCESSED =",
            tostring(gameProcessed)
        )

        -- F6/F7/F8 должны работать даже если Roblox/CoreGui
        -- пометил событие как gameProcessed.
        if input.KeyCode == TARGET_KEY then
            local target =
                pickTarget()

            if target then
                TargetPosition =
                    target

                createTargetMarker(
                    TargetPosition
                )

                print(
                    "[ATB Solver] TARGET SET =",
                    TargetPosition
                )
            else
                warn(
                    "[ATB Solver] Could not raycast target"
                )
            end

        elseif input.KeyCode == START_KEY then
            print(
                "[ATB Solver] F7 -> START REQUEST"
            )

            if not Running then
                JumpCount = 0
                LastExecutionPosition = nil
                LiveSteerAction = 0
            end

            task.spawn(
                function()
                    local ok, err =
                        xpcall(
                            startSolver,
                            function(errorObject)
                                local traceback =
                                    tostring(
                                        errorObject
                                    )

                                if debug
                                    and type(
                                        debug.traceback
                                    ) == "function"
                                then
                                    traceback =
                                        debug.traceback(
                                            traceback,
                                            2
                                        )
                                end

                                LastRuntimeError =
                                    traceback

                                warn(
                                    "[ATB Solver] F7 ERROR:",
                                    traceback
                                )

                                return traceback
                            end
                        )

                    if not ok then
                        print(
                            "[ATB Solver] F7 THREAD FAILED"
                        )
                    end
                end
            )

        elseif input.KeyCode == STOP_KEY then
            print(
                "[ATB Solver] F8 -> STOP REQUEST"
            )

            stopSolver()
        end
    end
)

--==============================================================--
-- EXTERNAL STOP
--==============================================================--

task.spawn(
    function()
        while
            ATB_ENV.ATBSolverRunning
        do
            if ATB_ENV.ATBSolverStop then
                break
            end

            task.wait(0.05)
        end
    end
)

--==============================================================--
-- CLEANUP
--==============================================================--

task.spawn(
    function()
        while
            ATB_ENV.ATBSolverRunning
            and not ATB_ENV.ATBSolverStop
        do
            task.wait(0.1)
        end

        if Destroyed then
            return
        end

        Destroyed = true

        ATB_ENV.ATBSolverActive =
            false

        DesiredMoveVector =
            Vector3.zero

        if MovementTable then
            pcall(
                function()
                    MovementTable.Movement = 0
                end
            )
        end

        if ControlHookInstalled
            and ControlModule
            and OriginalGetMoveVector
        then
            pcall(
                function()
                    ControlModule.GetMoveVector =
                        OriginalGetMoveVector
                end
            )
        end

        for _, connection in ipairs(
            Connections
        ) do
            pcall(
                function()
                    connection:Disconnect()
                end
            )
        end

        Connections = {}

        removeTargetMarker()

        ATB_ENV.ATBSolverRunning =
            false

        ATB_ENV.ATBSolverStop =
            true

        print(
            "[ATB Solver] CLEANED UP"
        )
    end
)

