-- CAMERA ALIGNMENT
--==============================================================--

local function setMovementInput(value)
    if not MovementTable then
        return false
    end

    local current =
        rawget(
            MovementTable,
            "Movement"
        )

    local currentType =
        typeof(current)

    local output = value

    if currentType == "Vector2" then
        output =
            Vector2.new(
                value,
                0
            )

    elseif currentType == "Vector3" then
        output =
            Vector3.new(
                value,
                0,
                0
            )

    elseif currentType == "number" then
        output = value

    else
        warn(
            "[ATB Solver] Unknown Movement type:",
            currentType,
            "value =",
            tostring(current)
        )

        return false
    end

    local ok, err =
        pcall(
            function()
                MovementTable.Movement =
                    output
            end
        )

    if not ok then
        warn(
            "[ATB Solver] Failed to set Movement:",
            err
        )

        return false
    end

    return true
end

local function updateCameraTowardYaw(targetYaw)
    if not MovementTable then
        return
    end

    if not Root then
        return
    end

    if targetYaw == nil then
        return
    end

    local currentYaw =
        cameraToYaw()

    local error =
        angleDifference(
            targetYaw,
            currentYaw
        )

    local targetInput =
        error
        / math.rad(
            DEG_PER_INPUT
        )

    targetInput =
        clamp(
            targetInput,
            -MAX_CAMERA_INPUT,
            MAX_CAMERA_INPUT
        )

    local now =
        tick()

    local dt =
        LastCameraUpdate
        and clamp(
            now - LastCameraUpdate,
            1 / 240,
            1 / 20
        )
        or (1 / 60)

    LastCameraUpdate =
        now

    local alpha =
        1
        - math.exp(
            -CAMERA_SMOOTH_SPEED
            * dt
        )

    SmoothedCameraInput =
        SmoothedCameraInput
        + (
            targetInput
            - SmoothedCameraInput
        )
        * alpha

    setMovementInput(
        SmoothedCameraInput
    )
end


