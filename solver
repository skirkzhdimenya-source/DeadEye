--==============================================================--
-- MATH
--==============================================================--

local function flat(v)
    return Vector3.new(
        v.X,
        0,
        v.Z
    )
end

local function safeUnit(v)
    local magnitude = v.Magnitude

    if magnitude < 0.000001 then
        return Vector3.zero
    end

    return v / magnitude
end

local function clamp(value, minimum, maximum)
    return math.max(
        minimum,
        math.min(
            maximum,
            value
        )
    )
end

local function angleDifference(a, b)
    local d = a - b

    while d > math.pi do
        d = d - math.pi * 2
    end

    while d < -math.pi do
        d = d + math.pi * 2
    end

    return d
end

--==============================================================--
-- YAW
--==============================================================--

-- Подтвержденная формула:
--
-- LookVector = (-sin(yaw), 0, cos(yaw))
--
local function vectorToYaw(vector)
    local horizontal =
        flat(vector)

    if horizontal.Magnitude < 0.000001 then
        return 0
    end

    horizontal =
        horizontal.Unit

    return math.atan2(
        -horizontal.X,
        horizontal.Z
    )
end

local function cameraToYaw()
    Camera =
        workspace.CurrentCamera

    if not Camera then
        return 0
    end

    local look =
        flat(
            Camera.CFrame.LookVector
        )

    if look.Magnitude < 0.000001 then
        return 0
    end

    look =
        look.Unit

    return math.atan2(
        -look.X,
        look.Z
    )
end

--==============================================================--
-- OPTIMAL AIR-STRAFE PERPENDICULAR
--==============================================================--

-- Для:
--
-- V = (X, 0, Z)
--
-- CameraLook = V.Unit
--
-- CameraRight = (-Z, 0, X)
--
-- Именно это направление было подтверждено последним логом:
--
-- Velocity =
-- (-4162.373, 0, -1157.690)
--
-- WishDirection = CameraRight for D
--
-- Dot = 0
--
local function rightPerpendicular(vector)
    local horizontal =
        flat(vector)

    local magnitude =
        horizontal.Magnitude

    if magnitude < 0.000001 then
        return Vector3.zero
    end

    -- CameraRight для LookVector = velocityDirection:
    -- (-Look.Z, 0, Look.X)
    -- D = +CameraRight, A = -CameraRight.
    return Vector3.new(
        -horizontal.Z / magnitude,
        0,
        horizontal.X / magnitude
    )
end

--==============================================================--
-- SAFE UPVALUE ACCESS
--==============================================================--

local function getUpvalueSafe(fn, index)
    if type(fn) ~= "function" then
        return nil, nil
    end

    if debug
        and type(debug.getupvalue) == "function"
    then
        local ok, name, value =
            pcall(
                debug.getupvalue,
                fn,
                index
            )

        if ok then
            return name, value
        end

        return nil, nil
    end

    if type(getupvalue) == "function" then
        local ok, name, value =
            pcall(
                getupvalue,
                fn,
                index
            )

        if ok then
            return name, value
        end
    end

    return nil, nil
end

--==============================================================--
-- FIND CAMERA INPUT MOVEMENT TABLE
--==============================================================--

local function findMovementTable()
    if type(getgc) ~= "function" then
        warn(
            "[ATB Solver] getgc is unavailable"
        )

        return nil
    end

    local ok, objects =
        pcall(
            getgc,
            true
        )

    if not ok
        or type(objects) ~= "table"
    then
        warn(
            "[ATB Solver] getgc(true) failed"
        )

        return nil
    end

    local function isMovementTable(value)
        if type(value) ~= "table" then
            return false
        end

        -- Не требуем сразу все четыре поля:
        -- часть реализаций CameraInput создаёт их лениво.
        local movement =
            rawget(value, "Movement")

        if movement == nil then
            return false
        end

        local pan =
            rawget(value, "Pan")

        local pinch =
            rawget(value, "Pinch")

        local wheel =
            rawget(value, "Wheel")

        return
            pan ~= nil
            or pinch ~= nil
            or wheel ~= nil
            or type(movement) == "number"
            or typeof(movement) == "Vector2"
            or typeof(movement) == "Vector3"
    end

    --==========================================================--
    -- PASS 1: direct tables in getgc(true)
    --==========================================================--

    for _, object in ipairs(objects) do
        if ATB_ENV.ATBSolverStop then
            return nil
        end

        if isMovementTable(object) then
            local keys = {}

            for key, value in pairs(object) do
                if #keys < 30 then
                    keys[#keys + 1] =
                        tostring(key)
                        .. "="
                        .. tostring(value)
                end
            end

            local description =
                table.concat(
                    keys,
                    ", "
                )

            print(
                "[ATB Solver] Movement table candidate:",
                "direct getgc table"
            )

            print(
                "[ATB Solver] Movement type =",
                typeof(object.Movement),
                "value =",
                tostring(object.Movement)
            )

            print(
                "[ATB Solver] Movement table keys =",
                description
            )

            return object
        end
    end

    --==========================================================--
    -- PASS 2: known CameraInput functions -> upvalues
    --==========================================================--

    for _, object in ipairs(objects) do
        if ATB_ENV.ATBSolverStop then
            return nil
        end

        if type(object) == "function" then
            local matched = false

            if debug
                and type(debug.getinfo) == "function"
            then
                local okInfo, info =
                    pcall(
                        debug.getinfo,
                        object
                    )

                if okInfo and info then
                    if info.name == "getRotation" then
                        matched = true

                    elseif type(info.source) == "string"
                        and string.find(
                            info.source,
                            "CameraInput",
                            1,
                            true
                        )
                    then
                        matched = true
                    end
                end
            end

            if matched then
                for index = 1, 20 do
                    local name, value =
                        getUpvalueSafe(
                            object,
                            index
                        )

                    if name ~= nil
                        and isMovementTable(value)
                    then
                        print(
                            "[ATB Solver] Movement table found:",
                            "CameraInput upvalue #"
                                .. tostring(index)
                        )

                        return value
                    end
                end
            end
        end
    end

    --==========================================================--
    -- PASS 3: structural fallback through ALL function upvalues
    --==========================================================--

    local inspectedTables = {}

    for _, object in ipairs(objects) do
        if ATB_ENV.ATBSolverStop then
            return nil
        end

        if type(object) == "function" then
            for index = 1, 20 do
                local name, value =
                    getUpvalueSafe(
                        object,
                        index
                    )

                if name ~= nil
                    and type(value) == "table"
                    and not inspectedTables[value]
                then
                    inspectedTables[value] = true

                    if isMovementTable(value) then
                        print(
                            "[ATB Solver] Movement table found:",
                            "structural upvalue #"
                                .. tostring(index),
                            "name =",
                            tostring(name)
                        )

                        return value
                    end
                end
            end
        end
    end

    --==========================================================--
    -- DIAGNOSTIC
    --
    -- Показываем таблицы, у которых вообще есть Movement,
    -- чтобы увидеть фактическую структуру после обновления игры.
    --==========================================================--

    local candidates = {}

    local function inspectCandidate(value, origin)
        if type(value) ~= "table" then
            return
        end

        local movement =
            rawget(value, "Movement")

        if movement == nil then
            return
        end

        local keys = {}

        for key, item in pairs(value) do
            if #keys < 20 then
                keys[#keys + 1] =
                    tostring(key)
                    .. "="
                    .. tostring(item)
            end
        end

        candidates[#candidates + 1] =
            origin
            .. " | Movement="
            .. tostring(movement)
            .. " | "
            .. table.concat(keys, ", ")
    end

    for _, object in ipairs(objects) do
        if type(object) == "table" then
            inspectCandidate(
                object,
                "direct"
            )
        elseif type(object) == "function" then
            for index = 1, 20 do
                local name, value =
                    getUpvalueSafe(
                        object,
                        index
                    )

                if name ~= nil
                    and type(value) == "table"
                then
                    inspectCandidate(
                        value,
                        "upvalue#"
                            .. tostring(index)
                            .. ":"
                            .. tostring(name)
                    )
                end
            end
        end

        if #candidates >= 30 then
            break
        end
    end

    if #candidates > 0 then
        local report =
            table.concat(
                candidates,
                "\n"
            )

        print(
            "========== MOVEMENT CANDIDATES =========="
        )

        print(report)

        print(
            "=========================================="
        )
    end

    warn(
        "[ATB Solver] CameraInput Movement table not found"
    )

    return nil
end

