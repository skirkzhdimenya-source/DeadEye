-- PICK TARGET
--==============================================================--

local function pickTarget()
    Camera =
        workspace.CurrentCamera

    if not Camera then
        return nil
    end

    if not Root then
        updateCharacter()
    end

    if not Root then
        return nil
    end

    local mousePosition =
        UserInputService:GetMouseLocation()

    local ray =
        Camera:ViewportPointToRay(
            mousePosition.X,
            mousePosition.Y
        )

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances = {
        Character
    }

    local result =
        workspace:Raycast(
            ray.Origin,
            ray.Direction * 10000,
            params
        )

    if not result then
        return nil
    end

    return result.Position
end

--==============================================================--
-- CAMERA ALIGNMENT
--==============================================================--

local function setMovementInput(value)
    if not MovementTable then
        return false
    end

    local current =
        rawget(
            MovementTable,
            "Movement"
        )

    local currentType =
        typeof(current)

    local output = value

    if currentType == "Vector2" then
        output =
            Vector2.new(
                value,
                0
            )

    elseif currentType == "Vector3" then
        output =
            Vector3.new(
                value,
                0,
                0
            )

    elseif currentType == "number" then
        output = value

    else
        warn(
            "[ATB Solver] Unknown Movement type:",
            currentType,
            "value =",
            tostring(current)
        )

        return false
    end

    local ok, err =
        pcall(
            function()
                MovementTable.Movement =
                    output
            end
        )

    if not ok then
        warn(
            "[ATB Solver] Failed to set Movement:",
            err
        )

        return false
    end

    return true
end

local function updateCameraTowardVelocity(action)
    if not MovementTable then
        return
    end

    if not Root then
        return
    end

    local velocity =
        flat(
            getInternalVelocity()
        )

    if velocity.Magnitude < 0.001 then
        velocity =
            flat(
                Root.CFrame.LookVector
            )
    end

    if velocity.Magnitude < 0.001 then
        return
    end

    local targetYaw =
        vectorToYaw(
            velocity
        )

    -- W+A / W+D: камера должна быть примерно под 45°
    -- к текущей velocity, чтобы диагональный input W+A/W+D
    -- давал направление, перпендикулярное velocity.
    if action == -1 then
        -- A: камера ~45° влево от velocity.
        targetYaw =
            targetYaw
            - math.rad(45)

    elseif action == 1 then
        -- D: камера ~45° вправо от velocity.
        targetYaw =
            targetYaw
            + math.rad(45)
    end

    local currentYaw =
        cameraToYaw()

    local error =
        angleDifference(
            targetYaw,
            currentYaw
        )

    local input =
        error
        / math.rad(
            DEG_PER_INPUT
        )

    input =
        clamp(
            input,
            -MAX_CAMERA_INPUT,
            MAX_CAMERA_INPUT
        )

    setMovementInput(input)
end

--==============================================================--
-- REAL JUMP
--==============================================================--

local function executeJump()
    if not GameCharacter then
        updateGameCharacter()
    end

    if not GameCharacter
        or not GameCharacter.Movement
    then
        return false
    end

    local ok, err =
        pcall(
            function()
                GameCharacter.Movement:
                    Jump(
                        nil,
                        true
                    )
            end
        )

    if not ok then
        warn(
            "[ATB Solver] Jump failed:",
            err
        )

        return false
    end

    return true
end

--==============================================================--
-- APPLY A / W / D
--==============================================================--

local function applyAction(action)
    if action == -1 then
        -- W + A
        DesiredMoveVector =
            Vector3.new(
                -1,
                0,
                -1
            ).Unit

    elseif action == 1 then
        -- W + D
        DesiredMoveVector =
            Vector3.new(
                1,
                0,
                -1
            ).Unit

    else
        -- W
        DesiredMoveVector =
            Vector3.new(
                0,
                0,
                -1
            )
    end
end

--==============================================================--
-- CLIPBOARD
--==============================================================--

local function copyReport(...)
    if type(setclipboard) ~= "function" then
        return
    end

    local parts = {...}
    local reportParts = {}

    for i, value in ipairs(parts) do
        reportParts[i] =
            tostring(value)
    end

    local report =
        table.concat(
            reportParts,
            "\n"
        )

    pcall(
        function()
            setclipboard(report)
        end
    )
end

--==============================================================--
-- ACTION TEXT
--==============================================================--

local function actionsToText(actions)
    local result = {}

    for i, action in ipairs(actions) do
        if action == -1 then
            result[i] = "A"
        elseif action == 1 then
            result[i] = "D"
        else
            result[i] = "W"
        end
    end

    return table.concat(
        result,
        " "
    )
end

--==============================================================--
-- START SOLVER
--==============================================================--

local function startSolver()
    if Running then
        return
    end

    if Destroyed then
        return
    end

    ATB_ENV.ATBSolverStop = false

    LastRuntimeError = nil
    ExecutionSamples = {}

    updateCharacter()
    updateGameCharacter()

    if not Root
        or not Humanoid
    then
        warn(
            "[ATB Solver] Character not ready"
        )

        return
    end

    if not TargetPosition then
        warn(
            "[ATB Solver] Target not selected. Press F6."
        )

        return
    end

    if not MovementTable then
        MovementTable =
            findMovementTable()

        if MovementTable then
            OriginalMovementValue =
                MovementTable.Movement

            print(
                "[ATB Solver] Movement type =",
                typeof(OriginalMovementValue),
                "initial value =",
                tostring(OriginalMovementValue)
            )
        end
    end

    if not MovementTable then
        warn(
            "[ATB Solver] Movement table not found"
        )

        return
    end

    if not setupControlModule() then
        return
    end

    JumpCount =
        JumpCount + 1

    Running = true

    ATB_ENV.ATBSolverActive = true

    print(
        "=================================================="
    )

    print(
        "[ATB Solver] JUMP #",
        JumpCount,
        "/",
        MAX_AUTO_JUMPS
    )

    print(
        "========== A -> B SOLVER START ==================="
    )

    print(
        "=================================================="
    )

    print(
        "TARGET =",
        TargetPosition
    )

    --==========================================================--
    -- PRE-ALIGN CAMERA
    --==========================================================--

    local alignStart =
        tick()

    while
        not ATB_ENV.ATBSolverStop
        and tick() - alignStart < 0.5
    do
        if not Root then
            break
        end

        DesiredMoveVector =
            Vector3.zero

        updateCameraTowardVelocity(0)

        local velocity =
            flat(
                getInternalVelocity()
            )

        if velocity.Magnitude > 0.001 then
            local error =
                math.deg(
                    math.abs(
                        angleDifference(
                            vectorToYaw(
                                velocity
                            ),
                            cameraToYaw()
                        )
                    )
                )

            if error < 0.2 then
                break
            end
        end

        RunService.RenderStepped:Wait()
    end

    if ATB_ENV.ATBSolverStop then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    --==========================================================--
    -- PRIME JUMP WITH REAL FORWARD INPUT
    --
    -- Раньше перед Jump() DesiredMoveVector был zero.
    -- Поэтому Jump() иногда стартовал строго на месте, а
    -- последующее ожидание горизонтальной скорости ничего
    -- не могло создать.
    --
    -- Сначала даём реальный W-ввод на один кадр, затем Jump().
    --==========================================================--

    DesiredMoveVector =
        Vector3.new(
            0,
            0,
            -1
        )

    updateCameraTowardVelocity(0)

    RunService.RenderStepped:Wait()

    if ATB_ENV.ATBSolverStop then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    local jumpSuccess =
        executeJump()

    if not jumpSuccess then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    -- Ждём первый физический кадр после Jump().
    RunService.Heartbeat:Wait()

    if ATB_ENV.ATBSolverStop then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    updateCharacter()
    updateGameCharacter()

    if not Root then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    -- Важный момент:
    -- DataRegistry.Velocity обновляется с задержкой, поэтому для
    -- начальной скорости после Jump() используем фактический
    -- AssemblyLinearVelocity и применяем подтверждённый scale 90.
    local rawStartVelocity =
        Root.AssemblyLinearVelocity

    local startVelocity =
        flat(
            rawStartVelocity
            * VELOCITY_SCALE
        )

    local startPosition =
        Root.Position

    local verticalVelocity =
        rawStartVelocity.Y

    print(
        "[ATB Solver] RAW POST-JUMP VELOCITY =",
        rawStartVelocity
    )

    print(
        "[ATB Solver] START VELOCITY FROM RAW =",
        startVelocity
    )

    local groundY =
        getRootGroundY()

    if not groundY then
        groundY =
            startPosition.Y
            - (
                Humanoid
                and Humanoid.HipHeight
                or 0
            )
    end

    local timeToLand =
        getDescendingTime(
            startPosition.Y,
            verticalVelocity,
            groundY
        )

    if not timeToLand then
        timeToLand =
            math.max(
                0.1,
                2
                    * verticalVelocity
                    / GRAVITY
            )
    end

    print(
        "START POSITION =",
        startPosition
    )

    print(
        "START VELOCITY INTERNAL =",
        startVelocity
    )

    if startVelocity.Magnitude < 0.001 then
        warn(
            "[ATB Solver] Horizontal jump velocity was not observed before planning"
        )
    end

    print(
        "START H SPEED INTERNAL =",
        startVelocity.Magnitude
    )

    print(
        "VERTICAL VELOCITY =",
        verticalVelocity
    )

    print(
        "TIME TO LAND =",
        timeToLand
    )

    --==========================================================--
    -- BUILD PLAN
    --==========================================================--

    local buildStart =
        tick()

    print(
        "[ATB Solver] BUILD PLAN START"
    )

    local plan =
        buildPlan(
            startPosition,
            startVelocity,
            timeToLand,
            TargetPosition
        )

    local buildDuration =
        tick()
        - buildStart

    print(
        "[ATB Solver] BUILD PLAN TIME =",
        buildDuration
    )

    if not plan then
        warn(
            "[ATB Solver] Could not build plan"
        )

        Running = false
        ATB_ENV.ATBSolverActive = false
        DesiredMoveVector = Vector3.zero

        if MovementTable then
            pcall(
                function()
                    MovementTable.Movement = 0
                end
            )
        end

        return
    end

    ActivePlan =
        plan.actions

    PlanIndex = 1

    local actionText =
        actionsToText(
            plan.actions
        )

    print(
        "=================================================="
    )

    print(
        "========== PLAN READY ============================"
    )

    print(
        "=================================================="
    )

    print(
        "STEPS =",
        plan.steps
    )

    print(
        "TIME =",
        plan.totalTime
    )

    print(
        "PREDICTED LANDING =",
        plan.predictedPosition
    )

    print(
        "PREDICTED ERROR =",
        plan.predictedDistance
    )

    print(
        "PLAN =",
        actionText
    )

    local report =
        table.concat(
            {
                "========== ATB SOLVER PLAN ==========",
                "",
                "TARGET = "
                    .. tostring(
                        TargetPosition
                    ),

                "START = "
                    .. tostring(
                        startPosition
                    ),

                "START V = "
                    .. tostring(
                        startVelocity
                    ),

                "START H = "
                    .. tostring(
                        startVelocity.Magnitude
                    ),

                "VERTICAL V = "
                    .. tostring(
                        verticalVelocity
                    ),

                "TIME TO LAND = "
                    .. tostring(
                        timeToLand
                    ),

                "",
                "PREDICTED LANDING = "
                    .. tostring(
                        plan.predictedPosition
                    ),

                "PREDICTED ERROR = "
                    .. tostring(
                        plan.predictedDistance
                    ),

                "",
                "PLAN = "
                    .. actionText
            },
            "\n"
        )

    copyReport(report)

    --==========================================================--
    -- EXECUTION
    --==========================================================--

    local executionStart =
        tick()

    local lastPlanIndex = 0

    while
        not ATB_ENV.ATBSolverStop
        and Root
        and Root.Parent
        and Humanoid
        and Humanoid.Health > 0
    do
        local elapsed =
            tick() - executionStart

        local index =
            math.floor(
                elapsed
                / SIM_DT
            ) + 1

        if index > #ActivePlan then
            index =
                #ActivePlan
        end

        PlanIndex =
            index

        local action =
            ActivePlan[index]

        if action == nil then
            action = 0
        end

        applyAction(action)

        updateCameraTowardVelocity(action)

        if PlanIndex == 1
            or PlanIndex == 5
            or PlanIndex == 10
            or PlanIndex == 20
            or PlanIndex == 40
            or PlanIndex == 60
            or PlanIndex == 80
        then
            local rawVelocity =
                Root.AssemblyLinearVelocity

            local internalVelocity =
                getInternalVelocity()

            local movementValue =
                MovementTable
                    and MovementTable.Movement
                    or nil

            ExecutionSamples[
                #ExecutionSamples + 1
            ] =
                table.concat(
                    {
                        "STEP = " .. tostring(PlanIndex),
                        "ACTION = " .. (
                            action == -1
                            and "A"
                            or action == 1
                            and "D"
                            or "W"
                        ),
                        "RAW V = "
                            .. tostring(rawVelocity),
                        "INTERNAL V = "
                            .. tostring(internalVelocity),
                        "MOVEMENT = "
                            .. tostring(movementValue),
                        "DESIRED = "
                            .. tostring(DesiredMoveVector)
                    },
                    " | "
                )
        end

        if PlanIndex ~= lastPlanIndex then
            lastPlanIndex =
                PlanIndex

            if PlanIndex % 5 == 0
                or PlanIndex == 1
            then
                local actionName =
                    action == -1
                    and "A"
                    or action == 1
                    and "D"
                    or "W"

                print(
                    "["
                        .. tostring(
                            PlanIndex
                        )
                        .. "/"
                        .. tostring(
                            #ActivePlan
                        )
                        .. "] ACTION = "
                        .. actionName
                )
            end
        end

        local state =
            Humanoid:GetState()

        if state ==
            Enum.HumanoidStateType.Landed
            or state ==
                Enum.HumanoidStateType.Running
            or state ==
                Enum.HumanoidStateType.RunningNoPhysics
        then
            break
        end

        RunService.RenderStepped:Wait()
    end

    --==========================================================--
    -- RESULT
    --==========================================================--

    local endPosition =
        Root
        and Root.Position
        or Vector3.zero

    local actualError =
        flat(
            TargetPosition
            - endPosition
        ).Magnitude

    local resultReport =
        table.concat(
            {
                "",
                "==================================================",
                "========== A -> B SOLVER END =====================",
                "JUMP = " .. tostring(JumpCount),
                "==================================================",

                "TARGET = "
                    .. tostring(
                        TargetPosition
                    ),

                "START = "
                    .. tostring(
                        startPosition
                    ),

                "END = "
                    .. tostring(
                        endPosition
                    ),

                "ACTUAL ERROR = "
                    .. tostring(
                        actualError
                    ),

                "PLAN STEPS = "
                    .. tostring(
                        #ActivePlan
                    ),

                "USED STEPS = "
                    .. tostring(
                        PlanIndex
                    ),

                "PREDICTED ERROR = "
                    .. tostring(
                        plan.predictedDistance
                    ),

                "",
                "START VELOCITY INTERNAL = "
                    .. tostring(
                        startVelocity
                    ),

                "START H SPEED INTERNAL = "
                    .. tostring(
                        startVelocity.Magnitude
                    ),

                "VERTICAL VELOCITY = "
                    .. tostring(
                        verticalVelocity
                    ),

                "TIME TO LAND = "
                    .. tostring(
                        timeToLand
                    ),

                "BUILD PLAN TIME = "
                    .. tostring(
                        buildDuration
                    ),

                "PLAN = "
                    .. tostring(
                        actionText
                    ),

                "",
                "EXECUTION SAMPLES = "
                    .. (
                        #ExecutionSamples > 0
                        and table.concat(
                            ExecutionSamples,
                            "\n"
                        )
                        or "none"
                    ),

                "",
                "RUNTIME ERROR = "
                    .. tostring(
                        LastRuntimeError
                            or "none"
                    ),

                "FINAL MOVEMENT TYPE = "
                    .. tostring(
                        MovementTable
                            and typeof(
                                MovementTable.Movement
                            )
                            or "nil"
                    ),

                "FINAL MOVEMENT VALUE = "
                    .. tostring(
                        MovementTable
                            and MovementTable.Movement
                            or "nil"
                    ),

                "FINAL DESIRED MOVE = "
                    .. tostring(
                        DesiredMoveVector
                    ),

                "CONTROL HOOK INSTALLED = "
                    .. tostring(
                        ControlHookInstalled
                    ),

                "=================================================="
            },
            "\n"
        )

    print(
        resultReport
    )

    print(
        "[ATB Solver] FINAL REPORT COPIED"
    )

    copyReport(
        resultReport
    )

    --==========================================================--
    -- AUTO NEXT JUMP
    --==========================================================--

    if not ATB_ENV.ATBSolverStop
        and actualError > TARGET_REACHED_DISTANCE
        and JumpCount < MAX_AUTO_JUMPS
    then
        print(
            "[ATB Solver] TARGET NOT REACHED.",
            "DISTANCE =",
            actualError,
            "STARTING NEXT JUMP..."
        )

        Running = false

        ATB_ENV.ATBSolverActive =
            false

        DesiredMoveVector =
            Vector3.zero

        if MovementTable then
            pcall(
                function()
                    MovementTable.Movement =
                        Vector2.zero
                end
            )
        end

        task.delay(
            0.15,
            function()
                if ATB_ENV.ATBSolverStop
                    or Destroyed
                then
                    return
                end

                if Running then
                    return
                end

                startSolver()
            end
        )

        return
    end

    if actualError <= TARGET_REACHED_DISTANCE then
        print(
            "[ATB Solver] TARGET REACHED.",
            "DISTANCE =",
            actualError
        )

    elseif JumpCount >= MAX_AUTO_JUMPS then
        warn(
            "[ATB Solver] MAX AUTO JUMPS REACHED.",
            "DISTANCE =",
            actualError
        )
    end

    Running = false

    ATB_ENV.ATBSolverActive =
        false

    DesiredMoveVector =
        Vector3.zero

    if MovementTable then
        pcall(
            function()
                MovementTable.Movement = 0
            end
        )
    end
end

