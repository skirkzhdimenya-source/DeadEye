connect(
    UserInputService.InputBegan,
    function(input, gameProcessed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end

        print(
            "[ATB Solver] KEY =",
            input.KeyCode,
            "PROCESSED =",
            tostring(gameProcessed)
        )

        -- F6/F7/F8 должны работать даже если Roblox/CoreGui
        -- пометил событие как gameProcessed.
        if input.KeyCode == TARGET_KEY then
            local target =
                pickTarget()

            if target then
                TargetPosition =
                    target

                createTargetMarker(
                    TargetPosition
                )

                print(
                    "[ATB Solver] TARGET SET =",
                    TargetPosition
                )
            else
                warn(
                    "[ATB Solver] Could not raycast target"
                )
            end

        elseif input.KeyCode == START_KEY then
            print(
                "[ATB Solver] F7 -> START REQUEST"
            )

            if not Running then
                JumpCount = 0
            end

            task.spawn(
                function()
                    local ok, err =
                        xpcall(
                            startSolver,
                            function(errorObject)
                                local traceback =
                                    tostring(
                                        errorObject
                                    )

                                if debug
                                    and type(
                                        debug.traceback
                                    ) == "function"
                                then
                                    traceback =
                                        debug.traceback(
                                            traceback,
                                            2
                                        )
                                end

                                LastRuntimeError =
                                    traceback

                                warn(
                                    "[ATB Solver] F7 ERROR:",
                                    traceback
                                )

                                return traceback
                            end
                        )

                    if not ok then
                        print(
                            "[ATB Solver] F7 THREAD FAILED"
                        )
                    end
                end
            )

        elseif input.KeyCode == STOP_KEY then
            print(
                "[ATB Solver] F8 -> STOP REQUEST"
            )

            stopSolver()
        end
    end
)

