local function setupControlModule()
    if ControlHookInstalled then
        return true
    end

    local ok, result =
        pcall(
            function()
                local playerModule =
                    LocalPlayer.PlayerScripts
                        :WaitForChild(
                            "PlayerModule"
                        )

                local module =
                    playerModule
                        :WaitForChild(
                            "ControlModule"
                        )

                return require(module)
            end
        )

    if not ok or not result then
        warn(
            "[ATB Solver] ControlModule not found"
        )

        return false
    end

    ControlModule = result

    if type(
        ControlModule.GetMoveVector
    ) ~= "function" then

        warn(
            "[ATB Solver] GetMoveVector missing"
        )

        return false
    end

    OriginalGetMoveVector =
        ControlModule.GetMoveVector

    ControlModule.GetMoveVector =
        function(self, ...)
            if ATB_ENV.ATBSolverStop
                or not ATB_ENV.ATBSolverRunning
                or not ATB_ENV.ATBSolverActive
            then
                return OriginalGetMoveVector(
                    self,
                    ...
                )
            end

            return DesiredMoveVector
        end

    ControlHookInstalled = true

    return true
end

