--==============================================================--
-- START SOLVER
--==============================================================--

local function predictLandingForAction(
    position,
    velocity,
    action,
    steerTime,
    remainingTime
)
    local predictedPosition =
        flat(position)

    local predictedVelocity =
        flat(
            velocity
        )

    local elapsed = 0

    while elapsed < remainingTime do
        local dt =
            math.min(
                SIM_DT,
                remainingTime - elapsed
            )

        local activeAction = 0

        if action ~= 0
            and elapsed < steerTime
        then
            activeAction =
                action
        end

        if activeAction == -1
            or activeAction == 1
        then
            if predictedVelocity.Magnitude > 0.001 then
                local perpendicular =
                    rightPerpendicular(
                        predictedVelocity
                    )

                if perpendicular.Magnitude > 0.001 then
                    predictedVelocity =
                        predictedVelocity
                        + (
                            perpendicular
                            * activeAction
                            * AIR_ADD
                        )
                end
            end

        elseif activeAction == 2 then
            -- Soft brake: accelerate opposite the current velocity.
            -- Never predict speed below the safety floor.
            local speed =
                predictedVelocity.Magnitude

            if speed > MIN_PRESERVED_SPEED_INTERNAL then
                predictedVelocity =
                    predictedVelocity
                    - (
                        predictedVelocity.Unit
                        * math.min(
                            AIR_ADD,
                            speed
                            - MIN_PRESERVED_SPEED_INTERNAL
                        )
                    )
            end
        end

        predictedPosition =
            predictedPosition
            + (
                predictedVelocity
                / VELOCITY_SCALE
            )
            * dt

        elapsed =
            elapsed + dt
    end

    return
        predictedPosition,
        predictedVelocity
end


local function getLiveSteering()
    if not Root then
        return 0, nil, 0, math.huge, math.huge, 0, 0, math.huge, math.huge, math.huge, 0
    end

    if not TargetPosition then
        return
            0,
            nil,
            0,
            math.huge,
            math.huge,
            0,
            0,
            math.huge,
            math.huge,
            math.huge,
            0
    end

    local delta =
        flat(
            TargetPosition
            - Root.Position
        )

    local distance =
        delta.Magnitude

    if distance < 0.001 then
        LiveSteerAction = 0

        return
            0,
            cameraToYaw(),
            0,
            distance,
            0,
            0,
            0,
            0,
            0,
            0
    end

    local rawVelocity =
        flat(
            Root.AssemblyLinearVelocity
        )

    local velocity =
        flat(
            getInternalVelocity()
        )

    if velocity.Magnitude < 0.001 then
        velocity =
            rawVelocity
            * VELOCITY_SCALE
    end

    if velocity.Magnitude < 0.001 then
        -- The custom movement may take several simulation frames to
        -- publish horizontal velocity. Do NOT replace W with N here.
        -- Keep W alive through the initial acceleration window.
        local stillStarting =
            JumpStartTime
            and (
                tick() - JumpStartTime
                < START_ACCELERATION_TIME
            )

        LiveSteerAction = 0

        if stillStarting then
            return
                0,
                cameraToYaw(),
                180,
                distance,
                distance,
                0,
                0,
                math.huge,
                math.huge,
                math.huge
        end

        return
            0,
            cameraToYaw(),
            180,
            distance,
            distance,
            0,
            0,
            math.huge,
            math.huge,
            math.huge
    end

    local velocityDirection =
        velocity.Unit

    --==========================================================--
    -- REAL END OF THIS JUMP
    --
    -- Do NOT derive the horizon from TargetPosition.Y.
    -- B can be visually above/below the current jump height.
    --
    -- JumpLandingDeadline is calculated once from the actual
    -- ground under the player immediately after Jump().
    --==========================================================--

    local remainingTime = 0

    if JumpLandingDeadline then
        remainingTime =
            math.max(
                0,
                JumpLandingDeadline - tick()
            )
    end

    if remainingTime <= 0 then
        return
            0,
            vectorToYaw(
                velocityDirection
            ),
            0,
            distance,
            distance,
            0,
            0,
            math.huge,
            math.huge,
            math.huge
    end

    --==========================================================--
    -- END-OF-JUMP CANDIDATE SOLVER
    --
    -- For the remaining time, simulate:
    --     A   = left strafe pulse
    --     N   = coast
    --     D   = right strafe pulse
    --     BRK = short controlled brake pulse
    --
    -- Pick the action whose FINAL horizontal position is closest
    -- to B. This targets the end of the jump directly instead of
    -- chasing B's instantaneous direction.
    --==========================================================--

    local candidates = {
        [-1] = nil,
        [0] = nil,
        [1] = nil
    }

    local bestAction = 0
    local bestDistance = math.huge
    local bestDuration = 0

    -- N means coast for the full remaining jump.
    local landingPosition,
        landingVelocity =
        predictLandingForAction(
            Root.Position,
            velocity,
            0,
            0,
            remainingTime
        )

    local error =
        flat(
            TargetPosition
            - landingPosition
        )

    candidates[0] = {
        position = landingPosition,
        velocity = landingVelocity,
        distance = error.Magnitude,
        score = error.Magnitude,
        error = error,
        duration = 0
    }

    bestDistance =
        candidates[0].score

    bestAction = 0
    bestDuration = 0

    -- For A, D and soft-brake, test a range of pulse lengths.
    -- After the pulse finishes, the trajectory coasts until the
    -- real end of jump.
    for _, action in ipairs({
        -1,
        1,
        2
    }) do
        local actionBest = nil

        for _, duration in ipairs(
            STEER_DURATIONS
        ) do
            if duration <= remainingTime then
                local candidatePosition,
                    candidateVelocity =
                    predictLandingForAction(
                        Root.Position,
                        velocity,
                        action,
                        duration,
                        remainingTime
                    )

                local candidateError =
                    flat(
                        TargetPosition
                        - candidatePosition
                    )

                local candidateScore =
                    candidateError.Magnitude

                local finalSpeed =
                    candidateVelocity.Magnitude

                if action == 2
                    and finalSpeed
                        <= MIN_PRESERVED_SPEED_INTERNAL
                then
                    candidateScore =
                        math.huge
                else
                    -- Speed is secondary to touchdown accuracy, but
                    -- avoid throwing away a large amount of momentum.
                    candidateScore =
                        candidateScore
                        + (
                            0.00003
                            * math.max(
                                0,
                                2000
                                    - finalSpeed
                            )
                        )
                end

                -- Avoid gratuitous A<->D reversals, but allow a
                -- correction when it materially improves touchdown.
                if LiveSteerAction ~= 0
                    and action ~= LiveSteerAction
                then
                    candidateScore =
                        candidateScore + 0.08
                end

                if not actionBest
                    or candidateScore < actionBest.score
                then
                    actionBest = {
                        position = candidatePosition,
                        velocity = candidateVelocity,
                        distance = candidateError.Magnitude,
                        score = candidateScore,
                        error = candidateError,
                        duration = duration
                    }
                end
            end
        end

        if actionBest then
            candidates[action] =
                actionBest

            if actionBest.score < bestDistance then
                bestDistance =
                    actionBest.score

                bestAction =
                    action

                bestDuration =
                    actionBest.duration
            end
        end
    end

    local currentCandidate =
        candidates[LiveSteerAction]

    -- Hysteresis only if keeping the current side is almost as good.
    if currentCandidate
        and currentCandidate.score
            <= bestDistance + 0.40
    then
        bestAction =
            LiveSteerAction

        bestDuration =
            currentCandidate.duration
            or 0
    end

    -- Never steer when simple coasting already lands essentially
    -- on the marker.
    if candidates[0]
        and candidates[0].distance
            <= STEER_RELEASE_CROSS
    then
        bestAction = 0
        bestDuration = 0
    end

    LiveSteerAction =
        bestAction

    local chosen =
        candidates[bestAction]

    if not chosen then
        chosen =
            candidates[0]
    end

    local cameraRight =
        rightPerpendicular(
            velocityDirection
        )

    local lateralError =
        chosen.error:Dot(
            cameraRight
        )

    local lateralMiss =
        math.abs(
            lateralError
        )

    local alongError =
        chosen.error:Dot(
            velocityDirection
        )

    local targetDirection =
        delta.Unit

    local headingDot =
        clamp(
            velocityDirection:Dot(
                targetDirection
            ),
            -1,
            1
        )

    local headingAngle =
        math.deg(
            math.acos(
                headingDot
            )
        )

    -- Only turn the camera while a strafe is actually required.
    -- When N wins, leave the camera untouched.
    local targetYaw

    if bestAction == -1
        or bestAction == 1
    then
        targetYaw =
            vectorToYaw(
                velocityDirection
            )

    elseif bestAction == 2 then
        targetYaw =
            vectorToYaw(
                -velocityDirection
            )

    else
        targetYaw =
            cameraToYaw()
    end

    return
        bestAction,
        targetYaw,
        headingAngle,
        distance,
        lateralMiss,
        remainingTime,
        alongError,
        candidates[-1] and candidates[-1].distance or math.huge,
        candidates[0] and candidates[0].distance or math.huge,
        candidates[1] and candidates[1].distance or math.huge,
        bestDuration
end

local function isGrounded()
    if not Humanoid or not Root then
        return false
    end

    local state =
        Humanoid:GetState()

    if state ==
        Enum.HumanoidStateType.Landed
    then
        return true
    end

    if Humanoid.FloorMaterial
        ~= Enum.Material.Air
    then
        return true
    end

    -- Дополнительная физическая проверка:
    -- действительно ли под root находится поверхность
    -- примерно на уровне ног.
    local result =
        getGroundRay()

    if not result then
        return false
    end

    local hipHeight =
        Humanoid.HipHeight

    local distance =
        (Root.Position.Y
            - result.Position.Y)

    return distance
        <= hipHeight + 0.35
end

local function waitForGrounded(timeout)
    local deadline =
        tick()
        + (timeout or 0.75)

    while
        not ATB_ENV.ATBSolverStop
        and not Destroyed
        and tick() < deadline
    do
        updateCharacter()

        if isGrounded() then
            return true
        end

        RunService.RenderStepped:Wait()
    end

    return isGrounded()
end

local function startSolver()
    if Running then
        return
    end

    if Destroyed then
        return
    end

    ATB_ENV.ATBSolverStop = false

    LastRuntimeError = nil
    ExecutionSamples = {}

    if JumpCount == 1 then
        LiveSteerAction = 0
        LastExecutionPosition = nil
        SmoothedCameraInput = 0
        LastCameraUpdate = tick()
    end

    if MovementTable then
        local initialMovement =
            rawget(
                MovementTable,
                "Movement"
            )

        if typeof(initialMovement) == "Vector2" then
            SmoothedCameraInput =
                initialMovement.X
        elseif typeof(initialMovement) == "number" then
            SmoothedCameraInput =
                initialMovement
        end
    end

    updateCharacter()
    updateGameCharacter()

    if not Root
        or not Humanoid
    then
        warn(
            "[ATB Solver] Character not ready"
        )

        return
    end

    if not TargetPosition then
        warn(
            "[ATB Solver] Target not selected. Press F6."
        )

        return
    end

    if not MovementTable then
        MovementTable =
            findMovementTable()

        if MovementTable then
            OriginalMovementValue =
                MovementTable.Movement

            print(
                "[ATB Solver] Movement type =",
                typeof(OriginalMovementValue),
                "initial value =",
                tostring(OriginalMovementValue)
            )
        end
    end

    if not MovementTable then
        warn(
            "[ATB Solver] Movement table not found"
        )

        return
    end

    if not setupControlModule() then
        return
    end

    -- После автоматического перехода ждём именно физический
    -- контакт с землёй. Это НЕ искусственная задержка:
    -- новый Jump() вызывается на первом grounded-кадре.
    if JumpCount > 0 then
        local grounded =
            waitForGrounded(0.75)

        if not grounded then
            warn(
                "[ATB Solver] Could not confirm grounded state for next jump"
            )

            Running = false
            ATB_ENV.ATBSolverActive = false
            return
        end
    end

    JumpCount =
        JumpCount + 1

    LastExecutionPosition = nil
    JumpLandingDeadline = nil

    PlanIndex = 1

    Running = true

    ATB_ENV.ATBSolverActive = true

    print(
        "=================================================="
    )

    print(
        "[ATB Solver] JUMP #",
        JumpCount,
        "/",
        MAX_AUTO_JUMPS
    )

    print(
        "========== A -> B SOLVER START ==================="
    )

    print(
        "=================================================="
    )

    print(
        "TARGET =",
        TargetPosition
    )

    --==========================================================--
    -- PRIME JUMP
    --
    -- IMPORTANT: nothing here targets B.
    --
    -- We deliberately start the jump using the camera direction
    -- that the player already has. This prevents the "first turn
    -- toward B without accelerating" that the previous version had.
    --
    -- The 0.01 second delay is the same timing value used by
    -- DeadEye's AutoJump module.
    --==========================================================--

    DesiredMoveVector =
        Vector3.new(
            0,
            0,
            -1
        )

    -- Give the movement input one frame to reach the native
    -- movement path, then use the requested 0.01s jump delay.
    RunService.RenderStepped:Wait()

    if ATB_ENV.ATBSolverStop then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    task.wait(
        JUMP_DELAY
    )

    local jumpSuccess =
        executeJump()

    if not jumpSuccess then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    JumpStartTime = tick()

    -- Ждём первый физический кадр после Jump().
    RunService.Heartbeat:Wait()

    if ATB_ENV.ATBSolverStop then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    updateCharacter()
    updateGameCharacter()

    if not Root then
        Running = false
        ATB_ENV.ATBSolverActive = false
        return
    end

    -- Важный момент:
    -- DataRegistry.Velocity обновляется с задержкой, поэтому для
    -- начальной скорости после Jump() используем фактический
    -- AssemblyLinearVelocity и применяем подтверждённый scale 90.
    local rawStartVelocity =
        Root.AssemblyLinearVelocity

    local startVelocity =
        flat(
            rawStartVelocity
            * VELOCITY_SCALE
        )

    local startPosition =
        Root.Position

    local verticalVelocity =
        rawStartVelocity.Y

    print(
        "[ATB Solver] RAW POST-JUMP VELOCITY =",
        rawStartVelocity
    )

    print(
        "[ATB Solver] START W WINDOW =",
        START_ACCELERATION_TIME
    )

    print(
        "[ATB Solver] START VELOCITY FROM RAW =",
        startVelocity
    )

    local currentGroundY =
        getRootGroundY()

    if not currentGroundY then
        currentGroundY =
            startPosition.Y
            - (
                Humanoid
                and Humanoid.HipHeight
                or 0
            )
    end

    local targetRootY =
        TargetPosition.Y
        + (
            Humanoid
            and Humanoid.HipHeight
            or 0
        )

    local targetTimeToLand =
        getDescendingTime(
            startPosition.Y,
            verticalVelocity,
            targetRootY
        )

    local floorTimeToLand =
        getDescendingTime(
            startPosition.Y,
            verticalVelocity,
            currentGroundY
        )

    local timeToLand =
        targetTimeToLand
        or floorTimeToLand

    local landingTimeSource =
        targetTimeToLand
        and "TARGET HEIGHT"
        or "CURRENT FLOOR"

    if not timeToLand then
        timeToLand =
            math.max(
                0.1,
                2
                    * verticalVelocity
                    / GRAVITY
            )

        landingTimeSource =
            "FALLBACK"
    end

    print(
        "START POSITION =",
        startPosition
    )

    print(
        "START VELOCITY INTERNAL =",
        startVelocity
    )

    if startVelocity.Magnitude < 0.001 then
        warn(
            "[ATB Solver] Horizontal jump velocity was not observed before planning"
        )
    end

    print(
        "START H SPEED INTERNAL =",
        startVelocity.Magnitude
    )

    print(
        "VERTICAL VELOCITY =",
        verticalVelocity
    )

    print(
        "TIME TO LAND =",
        timeToLand
    )

    print(
        "LANDING TIME SOURCE =",
        landingTimeSource
    )

    print(
        "TARGET ROOT Y =",
        targetRootY,
        "CURRENT FLOOR ROOT Y =",
        currentGroundY
    )

    -- The end of this jump uses the target height when that
    -- descending interception is physically reachable.
    JumpLandingDeadline =
        tick()
        + timeToLand

    --==========================================================--
    -- BUILD PLAN
    --==========================================================--

    --==========================================================--
    -- LIVE SOLVER
    --
    -- В боевом цикле НЕ строим beam-plan. Он создавал
    -- лишний freeze на десятки миллисекунд после каждого Jump.
    -- Steering принимается по фактической velocity/цели каждый кадр.
    --==========================================================--

    local buildDuration =
        0

    local plan = {
        actions = {},
        predictedPosition = TargetPosition,
        predictedVelocity = startVelocity,
        predictedDistance = 0,
        predictedApproachDot = 0,
        steps = 0,
        totalTime = timeToLand
    }

    local actionText =
        "LIVE TARGET STEERING"

    print(
        "[ATB Solver] LIVE STEERING ENABLED"
    )

    --==========================================================--
    -- EXECUTION
    --==========================================================--

    local executionStart =
        tick()

    local lastLogAction = nil
    local lastLogAngle = nil

    while
        not ATB_ENV.ATBSolverStop
        and Root
        and Root.Parent
        and Humanoid
        and Humanoid.Health > 0
    do
        PlanIndex =
            math.floor(
                (
                    tick()
                    - executionStart
                )
                / SIM_DT
            ) + 1

        local action,
            targetYaw,
            headingAngle,
            targetDistance,
            lateralMiss,
            remainingTime,
            alongError,
            predictedA,
            predictedN,
            predictedD,
            steerDuration =
            getLiveSteering()

        local startupActive =
            JumpStartTime
            and (
                tick() - JumpStartTime
                < START_ACCELERATION_TIME
            )

        if startupActive
            and Root.AssemblyLinearVelocity
                .Magnitude < 8
        then
            -- Force forward input while the movement stack catches up.
            action = 0
        end

        if startupActive then
            -- W must remain held during startup even though getLiveSteering
            -- returns action 0 for "no lateral correction".
            DesiredMoveVector =
                Vector3.new(
                    0,
                    0,
                    -1
                )

        elseif action == -1 then
            DesiredMoveVector =
                Vector3.new(
                    -1,
                    0,
                    -1
                ).Unit

        elseif action == 1 then
            DesiredMoveVector =
                Vector3.new(
                    1,
                    0,
                    -1
                ).Unit

        elseif action == 2 then
            -- BRK = W while camera looks opposite velocity.
            DesiredMoveVector =
                Vector3.new(
                    0,
                    0,
                    -1
                )

        else
            DesiredMoveVector =
                Vector3.zero
        end

        updateCameraTowardYaw(
            targetYaw
        )

        local currentPosition =
            Root.Position

        --======================================================--
        -- TARGET TOUCH CHECK
        --
        -- Нужна именно точка касания ногами:
        -- root.Y должен быть примерно на HipHeight выше B.
        --======================================================--

        local targetGroundY =
            TargetPosition.Y
            + (
                Humanoid
                and Humanoid.HipHeight
                or 0
            )

        local descending =
            Root.AssemblyLinearVelocity.Y
            <= 0

        local nearTouchHeight =
            math.abs(
                currentPosition.Y
                - targetGroundY
            )
            <= 1.25

        -- Дополнительная проверка отрезка движения:
        -- на большой скорости можно пролететь через небольшой
        -- радиус между двумя RenderStepped-кадрами.
        local segmentHit = false

        if LastExecutionPosition then
            local segment =
                currentPosition
                - LastExecutionPosition

            local lengthSquared =
                flat(segment).Magnitude
                * flat(segment).Magnitude

            if lengthSquared > 0.000001 then
                local fromTarget =
                    flat(
                        TargetPosition
                        - LastExecutionPosition
                    )

                local projection =
                    fromTarget:Dot(
                        flat(segment)
                    )
                    / lengthSquared

                projection =
                    clamp(
                        projection,
                        0,
                        1
                    )

                local closest =
                    LastExecutionPosition
                    + segment * projection

                local segmentDistance =
                    flat(
                        TargetPosition
                        - closest
                    ).Magnitude

                if segmentDistance
                    <= TARGET_TOUCH_DISTANCE
                then
                    segmentHit = true
                end
            end
        end

        LastExecutionPosition =
            currentPosition

        if targetDistance
            <= TARGET_TOUCH_DISTANCE
            and descending
            and nearTouchHeight
        then
            print(
                "[ATB Solver] TOUCHDOWN TARGET HIT.",
                "DISTANCE =",
                targetDistance,
                "HEADING =",
                headingAngle
            )

            break
        end

        if segmentHit
            and descending
            and nearTouchHeight
        then
            print(
                "[ATB Solver] TARGET SEGMENT HIT.",
                "DISTANCE =",
                targetDistance,
                "HEADING =",
                headingAngle
            )

            break
        end

        if action ~= lastLogAction
            or (
                lastLogAngle == nil
                or math.abs(
                    headingAngle
                    - lastLogAngle
                ) > 5
            )
        then
            print(
                "[ATB Solver] STEER =",
                action == -1
                    and "A"
                    or action == 1
                    and "D"
                    or action == 2
                    and "BRK"
                    or "N",
                "HEADING =",
                headingAngle,
                "DISTANCE =",
                targetDistance,
                "PREDICTED END MISS =",
                lateralMiss,
                "ALONG ERROR =",
                alongError,
                "REMAINING =",
                remainingTime,
                "PRED A/N/D =",
                predictedA,
                predictedN,
                predictedD,
                "STEER DURATION =",
                steerDuration
            )

            lastLogAction =
                action

            lastLogAngle =
                headingAngle
        end

        local state =
            Humanoid:GetState()

        if state ==
            Enum.HumanoidStateType.Landed
            or state ==
                Enum.HumanoidStateType.Running
            or state ==
                Enum.HumanoidStateType.RunningNoPhysics
        then
            break
        end

        RunService.RenderStepped:Wait()
    end

    --==========================================================--
    -- RESULT
    --==========================================================--

    local endPosition =
        Root
        and Root.Position
        or Vector3.zero

    local actualError =
        flat(
            TargetPosition
            - endPosition
        ).Magnitude

    local resultReport =
        table.concat(
            {
                "",
                "==================================================",
                "========== A -> B SOLVER END =====================",
                "JUMP = " .. tostring(JumpCount),
                "==================================================",

                "TARGET = "
                    .. tostring(
                        TargetPosition
                    ),

                "START = "
                    .. tostring(
                        startPosition
                    ),

                "END = "
                    .. tostring(
                        endPosition
                    ),

                "ACTUAL ERROR = "
                    .. tostring(
                        actualError
                    ),

                "LIVE STEPS = "
                    .. tostring(
                        PlanIndex
                    ),

                "USED STEPS = "
                    .. tostring(
                        PlanIndex
                    ),

                "MODE = LIVE TARGET STEERING",

                "PREDICTED ERROR = live steering",

                "PREDICTED APPROACH DOT = live steering",

                "",
                "START VELOCITY INTERNAL = "
                    .. tostring(
                        startVelocity
                    ),

                "START H SPEED INTERNAL = "
                    .. tostring(
                        startVelocity.Magnitude
                    ),

                "VERTICAL VELOCITY = "
                    .. tostring(
                        verticalVelocity
                    ),

                "TIME TO LAND = "
                    .. tostring(
                        timeToLand
                    ),

                "BUILD PLAN TIME = "
                    .. tostring(
                        buildDuration
                    ),

                "PLAN = "
                    .. tostring(
                        actionText
                    ),

                "",
                "EXECUTION SAMPLES = "
                    .. (
                        #ExecutionSamples > 0
                        and table.concat(
                            ExecutionSamples,
                            "\n"
                        )
                        or "none"
                    ),

                "",
                "RUNTIME ERROR = "
                    .. tostring(
                        LastRuntimeError
                            or "none"
                    ),

                "FINAL MOVEMENT TYPE = "
                    .. tostring(
                        MovementTable
                            and typeof(
                                MovementTable.Movement
                            )
                            or "nil"
                    ),

                "FINAL MOVEMENT VALUE = "
                    .. tostring(
                        MovementTable
                            and MovementTable.Movement
                            or "nil"
                    ),

                "FINAL DESIRED MOVE = "
                    .. tostring(
                        DesiredMoveVector
                    ),

                "CONTROL HOOK INSTALLED = "
                    .. tostring(
                        ControlHookInstalled
                    ),

                "=================================================="
            },
            "\n"
        )

    print(
        resultReport
    )

    print(
        "[ATB Solver] FINAL REPORT COPIED"
    )

    copyReport(
        resultReport
    )

    --==========================================================--
    -- AUTO NEXT JUMP
    --==========================================================--

    if not ATB_ENV.ATBSolverStop
        and actualError > TARGET_REACHED_DISTANCE
        and JumpCount < MAX_AUTO_JUMPS
    then
        print(
            "[ATB Solver] TARGET NOT REACHED.",
            "DISTANCE =",
            actualError,
            "STARTING NEXT JUMP..."
        )

        Running = false

        ATB_ENV.ATBSolverActive =
            false

        -- Не обнуляем DesiredMoveVector / Movement между
        -- прыжками: персонаж должен сохранить input и скорость
        -- до следующего Jump().
        task.defer(
            function()
                if ATB_ENV.ATBSolverStop
                    or Destroyed
                then
                    return
                end

                if Running then
                    return
                end

                startSolver()
            end
        )

        return
    end

    if actualError <= TARGET_REACHED_DISTANCE then
        print(
            "[ATB Solver] TARGET REACHED.",
            "DISTANCE =",
            actualError
        )

    elseif JumpCount >= MAX_AUTO_JUMPS then
        warn(
            "[ATB Solver] MAX AUTO JUMPS REACHED.",
            "DISTANCE =",
            actualError
        )
    end

    Running = false

    ATB_ENV.ATBSolverActive =
        false

    DesiredMoveVector =
        Vector3.zero

    SmoothedCameraInput = 0
    LastCameraUpdate = nil
    JumpLandingDeadline = nil
    JumpStartTime = nil

    if MovementTable then
        pcall(
            function()
                MovementTable.Movement = 0
            end
        )
    end
end

--==============================================================--
-- STOP
--==============================================================--

local function stopSolver()
    if Destroyed then
        return
    end

    ATB_ENV.ATBSolverStop = true

    Running = false

    ATB_ENV.ATBSolverActive = false

    DesiredMoveVector =
        Vector3.zero

    JumpLandingDeadline = nil
    JumpStartTime = nil

    if MovementTable then
        pcall(
            function()
                MovementTable.Movement = 0
            end
        )
    end

    print(
        "[ATB Solver] STOP"
    )
end

--==============================================================--
-- INPUT
--==============================================================--

connect(
    UserInputService.InputBegan,
    function(input, gameProcessed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end

        print(
            "[ATB Solver] KEY =",
            input.KeyCode,
            "PROCESSED =",
            tostring(gameProcessed)
        )

        -- F6/F7/F8 должны работать даже если Roblox/CoreGui
        -- пометил событие как gameProcessed.
        if input.KeyCode == TARGET_KEY then
            local target =
                pickTarget()

            if target then
                TargetPosition =
                    target

                createTargetMarker(
                    TargetPosition
                )

                print(
                    "[ATB Solver] TARGET SET =",
                    TargetPosition
                )
            else
                warn(
                    "[ATB Solver] Could not raycast target"
                )
            end

        elseif input.KeyCode == START_KEY then
            print(
                "[ATB Solver] F7 -> START REQUEST"
            )

            if not Running then
                JumpCount = 0
                LastExecutionPosition = nil
                LiveSteerAction = 0
            end

            task.spawn(
                function()
                    local ok, err =
                        xpcall(
                            startSolver,
                            function(errorObject)
                                local traceback =
                                    tostring(
                                        errorObject
                                    )

                                if debug
                                    and type(
                                        debug.traceback
                                    ) == "function"
                                then
                                    traceback =
                                        debug.traceback(
                                            traceback,
                                            2
                                        )
                                end

                                LastRuntimeError =
                                    traceback

                                warn(
                                    "[ATB Solver] F7 ERROR:",
                                    traceback
                                )

                                return traceback
                            end
                        )

                    if not ok then
                        print(
                            "[ATB Solver] F7 THREAD FAILED"
                        )
                    end
                end
            )

        elseif input.KeyCode == STOP_KEY then
            print(
                "[ATB Solver] F8 -> STOP REQUEST"
            )

            stopSolver()
        end
    end
)

--==============================================================--
-- EXTERNAL STOP
--==============================================================--

task.spawn(
    function()
        while
            ATB_ENV.ATBSolverRunning
        do
            if ATB_ENV.ATBSolverStop then
                break
            end

            task.wait(0.05)
        end
    end
)

--==============================================================--
-- CLEANUP
--==============================================================--

task.spawn(
    function()
        while
            ATB_ENV.ATBSolverRunning
            and not ATB_ENV.ATBSolverStop
        do
            task.wait(0.1)
        end

        if Destroyed then
            return
        end

        Destroyed = true

        ATB_ENV.ATBSolverActive =
            false

        DesiredMoveVector =
            Vector3.zero

        if MovementTable then
            pcall(
                function()
                    MovementTable.Movement = 0
                end
            )
        end

        if ControlHookInstalled
            and ControlModule
            and OriginalGetMoveVector
        then
            pcall(
                function()
                    ControlModule.GetMoveVector =
                        OriginalGetMoveVector
                end
            )
        end

        for _, connection in ipairs(
            Connections
        ) do
            pcall(
                function()
                    connection:Disconnect()
                end
            )
        end

        Connections = {}

        removeTargetMarker()

        ATB_ENV.ATBSolverRunning =
            false

        ATB_ENV.ATBSolverStop =
            true

        print(
            "[ATB Solver] CLEANED UP"
        )
    end
)

