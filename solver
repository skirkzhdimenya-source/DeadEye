local function removeTargetMarker()
    if TargetMarker then
        pcall(
            function()
                TargetMarker:Destroy()
            end
        )

        TargetMarker = nil
    end
end

local function createTargetMarker(position)
    removeTargetMarker()

    local marker =
        Instance.new("Part")

    marker.Name =
        "ATB_Target"

    marker.Shape =
        Enum.PartType.Ball

    marker.Size =
        Vector3.new(
            1.2,
            1.2,
            1.2
        )

    marker.Anchored = true

    marker.CanCollide = false
    marker.CanTouch = false
    marker.CanQuery = false

    marker.Material =
        Enum.Material.Neon

    marker.Transparency = 0.2

    marker.Position =
        position

    marker.Parent =
        workspace

    TargetMarker =
        marker
end

--==============================================================--
-- PICK TARGET
--==============================================================--

local function pickTarget()
    Camera =
        workspace.CurrentCamera

    if not Camera then
        return nil
    end

    if not Root then
        updateCharacter()
    end

    if not Root then
        return nil
    end

    local mousePosition =
        UserInputService:GetMouseLocation()

    local ray =
        Camera:ViewportPointToRay(
            mousePosition.X,
            mousePosition.Y
        )

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances = {
        Character
    }

    local result =
        workspace:Raycast(
            ray.Origin,
            ray.Direction * 10000,
            params
        )

    if not result then
        return nil
    end

    return result.Position
end

