--==============================================================--
-- DESCENDING TIME
--==============================================================--

local function getDescendingTime(
    currentY,
    verticalVelocity,
    targetY
)
    local deltaY =
        targetY - currentY

    local discriminant =
        verticalVelocity
            * verticalVelocity
        - 2
            * GRAVITY
            * deltaY

    if discriminant < 0 then
        return nil
    end

    local sqrtDiscriminant =
        math.sqrt(discriminant)

    local t1 =
        (
            verticalVelocity
            - sqrtDiscriminant
        )
        / GRAVITY

    local t2 =
        (
            verticalVelocity
            + sqrtDiscriminant
        )
        / GRAVITY

    local best = nil

    if t1 > 0 then
        local vy1 =
            verticalVelocity
            - GRAVITY * t1

        if vy1 < 0 then
            best = t1
        end
    end

    if t2 > 0 then
        local vy2 =
            verticalVelocity
            - GRAVITY * t2

        if vy2 < 0
            and (
                not best
                or t2 < best
            )
        then
            best = t2
        end
    end

    return best
end

--==============================================================--
-- AIR SIMULATION
--==============================================================--

-- За один реальный Accelerate call:
--
-- Vnew = V + 182 * perpendicular(V)
--
-- при оптимальной camera alignment.
--
local function simulateAirStep(
    position,
    velocity,
    side,
    dt
)
    local newVelocity =
        velocity

    if side ~= 0 then
        local perpendicular =
            rightPerpendicular(
                velocity
            )

        if perpendicular.Magnitude
            > 0.000001
        then
            local wish =
                perpendicular * side

            newVelocity =
                velocity
                + wish * AIR_ADD
        end
    end

    local newPosition =
        position
        + (
            newVelocity
            / VELOCITY_SCALE
        )
        * dt

    return
        newPosition,
        newVelocity
end

--==============================================================--
-- MAXIMUM TRAVEL HEURISTIC
--==============================================================--

local function estimateMaxTravel(
    velocity,
    remainingTime
)
    local speed =
        flat(velocity).Magnitude

    local elapsed = 0
    local distance = 0

    while elapsed < remainingTime do
        local dt =
            math.min(
                SIM_DT,
                remainingTime - elapsed
            )

        distance =
            distance
            + (
                speed
                / VELOCITY_SCALE
            )
            * dt

        speed =
            math.sqrt(
                speed * speed
                + AIR_ADD * AIR_ADD
            )

        elapsed =
            elapsed + dt
    end

    return distance
end

--==============================================================--
-- HEURISTIC
--==============================================================--

local function stateHeuristic(
    state,
    target,
    remainingTime
)
    -- Дешёвая эвристика для beam sorting.
    -- Предыдущая версия внутри каждого сравнения запускала
    -- дополнительные циклы на всё оставшееся время, из-за чего
    -- F7 мог надолго подвешивать клиент.

    local delta =
        target
        - state.position

    local distance =
        delta.Magnitude

    if distance < 0.001 then
        return
            state.switches
            * SWITCH_PENALTY
    end

    local velocity =
        flat(
            state.velocity
        )

    local velocityMagnitude =
        velocity.Magnitude

    local headingPenalty = 0

    if velocityMagnitude > 0.001 then
        local velocityYaw =
            vectorToYaw(
                velocity
            )

        local targetYaw =
            vectorToYaw(
                delta
            )

        local headingError =
            math.abs(
                angleDifference(
                    targetYaw,
                    velocityYaw
                )
            )

        local timeFactor =
            1
            + math.max(
                0,
                0.5
                    - remainingTime
            )

        headingPenalty =
            headingError
            * 20
            * timeFactor
    end

    return
        distance
        + headingPenalty
        + state.switches
        * SWITCH_PENALTY
end

--==============================================================--
-- SORT / TRIM
--==============================================================--

local function sortAndTrim(
    states,
    target,
    remainingTime
)
    -- Считаем score ровно один раз для каждого состояния.
    -- table.sort() может вызвать comparator много раз; раньше
    -- stateHeuristic() пересчитывался на каждом сравнении.

    for _, state in ipairs(states) do
        state.score =
            stateHeuristic(
                state,
                target,
                remainingTime
            )
    end

    table.sort(
        states,
        function(a, b)
            return a.score < b.score
        end
    )

    while #states > BEAM_WIDTH do
        table.remove(states)
    end

    return states
end

--==============================================================--
-- BUILD PLAN
--==============================================================--

local function buildPlan(
    startPosition,
    startVelocity,
    totalTime,
    target
)
    local stepCount =
        math.max(
            1,
            math.ceil(
                totalTime
                / SIM_DT
            )
        )

    -- Храним только parent + action вместо копии полного
    -- массива actions у каждого состояния.
    local states = {
        {
            position =
                flat(
                    startPosition
                ),

            velocity =
                flat(
                    startVelocity
                ),

            parent = nil,
            action = nil,
            lastAction = 0,
            switches = 0,
            score = 0
        }
    }

    local targetFlat =
        flat(target)

    for stepIndex = 1, stepCount do
        if ATB_ENV.ATBSolverStop then
            return nil
        end

        local nextStates = {}

        local remainingAfter =
            math.max(
                0,
                totalTime
                - stepIndex
                * SIM_DT
            )

        for _, state in ipairs(states) do
            for _, side in ipairs({
                -1,
                0,
                1
            }) do
                local position,
                    velocity =
                    simulateAirStep(
                        state.position,
                        state.velocity,
                        side,
                        SIM_DT
                    )

                local switches =
                    state.switches

                if side ~= 0
                    and state.lastAction ~= 0
                    and side ~= state.lastAction
                then
                    switches =
                        switches + 1

                elseif side ~= 0
                    and state.lastAction == 0
                then
                    switches =
                        switches + 1
                end

                local child = {
                    position = position,
                    velocity = velocity,
                    parent = state,
                    action = side,
                    lastAction = side,
                    switches = switches
                }

                nextStates[
                    #nextStates + 1
                ] = child
            end
        end

        states =
            sortAndTrim(
                nextStates,
                targetFlat,
                remainingAfter
            )
    end

    local best = nil
    local bestScore =
        math.huge

    local bestDistance =
        math.huge

    local bestApproachDot =
        0

    for _, state in ipairs(states) do
        local errorVector =
            targetFlat
            - state.position

        local distance =
            errorVector.Magnitude

        local velocity =
            flat(
                state.velocity
            )

        local approachDot = 0
        local approachPenalty = 0

        if velocity.Magnitude > 0.001
            and distance > 0.001
        then
            approachDot =
                velocity.Unit:Dot(
                    errorVector.Unit
                )

            -- Скорость, направленная от точки, особенно плоха:
            -- такой state начинает обходить B по дуге.
            local away =
                math.max(
                    0,
                    -approachDot
                )

            -- Для касания желательно, чтобы траектория
            -- проходила через B, а не касалась её по касательной.
            local lateral =
                math.sqrt(
                    math.max(
                        0,
                        1
                            - approachDot
                            * approachDot
                    )
                )

            approachPenalty =
                away * 40
                + lateral
                    * math.min(
                        distance,
                        20
                    )
                    * 0.8
        end

        local score =
            distance
            + approachPenalty
            + state.switches
                * SWITCH_PENALTY

        if score < bestScore then
            bestScore =
                score

            bestDistance =
                distance

            bestApproachDot =
                approachDot

            best = state
        end
    end

    if not best then
        return nil
    end

    -- Восстанавливаем последовательность действий по parent-ссылкам.
    local reversedActions = {}
    local cursor = best

    while cursor
        and cursor.parent
    do
        reversedActions[
            #reversedActions + 1
        ] = cursor.action

        cursor = cursor.parent
    end

    local actions = {}

    for i = #reversedActions, 1, -1 do
        actions[
            #actions + 1
        ] = reversedActions[i]
    end

    return {
        actions = actions,

        predictedPosition =
            best.position,

        predictedVelocity =
            best.velocity,

        predictedDistance =
            bestDistance,

        predictedApproachDot =
            bestApproachDot,

        steps = stepCount,

        totalTime = totalTime
    }
end

