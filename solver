local function stopSolver()
    if Destroyed then
        return
    end

    ATB_ENV.ATBSolverStop = true

    Running = false

    ATB_ENV.ATBSolverActive = false

    DesiredMoveVector =
        Vector3.zero

    if MovementTable then
        pcall(
            function()
                MovementTable.Movement = 0
            end
        )
    end

    print(
        "[ATB Solver] STOP"
    )
end

