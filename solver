-- REAL JUMP
--==============================================================--

local function executeJump()
    if not GameCharacter then
        updateGameCharacter()
    end

    if not GameCharacter
        or not GameCharacter.Movement
    then
        return false
    end

    local ok, err =
        pcall(
            function()
                GameCharacter.Movement:
                    Jump(
                        nil,
                        true
                    )
            end
        )

    if not ok then
        warn(
            "[ATB Solver] Jump failed:",
            err
        )

        return false
    end

    return true
end

--==============================================================--
-- APPLY A / W / D
--==============================================================--

local function applyAction(action)
    if action == -1 then
        -- A
        DesiredMoveVector =
            Vector3.new(
                -1,
                0,
                -1
            ).Unit

    elseif action == 1 then
        -- D
        DesiredMoveVector =
            Vector3.new(
                1,
                0,
                -1
            ).Unit

    else
        -- N: не подаём lateral input в воздухе.
        DesiredMoveVector =
            Vector3.zero
    end
end

